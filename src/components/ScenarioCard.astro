---
import type { Dictionary } from '../i18n/index';

interface Props {
  id: string;
  title: string;
  environment: string;
  dangerLevel: number;
  href: string;
  dict: Dictionary;
}

const { id, title, environment, dangerLevel, href, dict } = Astro.props;

const dangerColors: Record<number, { bg: string; text: string }> = {
  1: { bg: 'bg-ok-soft', text: 'text-ok' },
  2: { bg: 'bg-blue-soft', text: 'text-blue' },
  3: { bg: 'bg-warn-soft', text: 'text-warn' },
  4: { bg: 'bg-warn-soft', text: 'text-warn' },
  5: { bg: 'bg-danger-soft', text: 'text-danger' },
};
const danger = dangerColors[dangerLevel] ?? dangerColors[1];
const dangerLabel = dict.danger[['low', 'moderate', 'high', 'severe', 'extreme'][dangerLevel - 1] as keyof typeof dict.danger];

const icons: Record<string, string> = {
  island: '<path d="M12 22c-4.97 0-9-2.69-9-6s4.03-6 9-6 9 2.69 9 6-4.03 6-9 6z" stroke-linecap="round"/><path d="M9 10c0-1.66 1.34-3 3-3s3 1.34 3 3" stroke-linecap="round"/>',
  desert: '<path d="M4 20h16M8 20c0-4 2-8 4-8s4 4 4 8M14 12c1-2 2-4 2-6" stroke-linecap="round" stroke-linejoin="round"/>',
  arctic: '<path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke-linecap="round"/>',
  jungle: '<path d="M12 3c-2 3-6 5-6 10a6 6 0 0 0 12 0c0-5-4-7-6-10z" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 13v4" stroke-linecap="round"/>',
  mountain: '<path d="M3 20l5-12 4 6 3-8 6 14" stroke-linecap="round" stroke-linejoin="round"/>',
  ocean: '<path d="M2 12c1-2 3-2 4 0s3 2 4 0 3-2 4 0 3 2 4 0 3-2 4 0" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17c1-2 3-2 4 0s3 2 4 0 3-2 4 0 3 2 4 0 3-2 4 0" stroke-linecap="round" stroke-linejoin="round"/>',
  'urban-ruins': '<path d="M3 21h18M5 21V7l4-3v17M9 21V4l4-2v19M13 21V7l4-3v17M17 21V4l4-3v20" stroke-linecap="round" stroke-linejoin="round"/>',
  wildfire: '<path d="M12 23c-4 0-7-3-7-7 0-4 5-9 5-13a7 7 0 0 1 14 0c0 4 5 9 5 13 0 4-3 7-7 7z" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 23c-1.5 0-3-1.5-3-3.5 0-2 2-4 3-6 1 2 3 4 3 6 0 2-1.5 3.5-3 3.5z" stroke-linecap="round"/>',
};
---

<a href={href} class="card group p-6">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-md bg-blue-soft flex items-center justify-center shrink-0">
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-blue" fill="none" stroke="currentColor" stroke-width="1.8">
          <Fragment set:html={icons[id] ?? icons.mountain} />
        </svg>
      </div>
      <div>
        <h3 class="font-serif text-[1.06rem] font-semibold leading-snug tracking-tight">{title}</h3>
        <p class="text-[12.5px] text-ink-faint mt-0.5">{environment}</p>
      </div>
    </div>
    <span class:list={['shrink-0 text-[10.5px] font-medium px-2 py-0.5 rounded-sm', danger.bg, danger.text]}>
      {dangerLabel}
    </span>
  </div>
  <div class="flex items-center gap-1">
    {[1, 2, 3, 4, 5].map((i) => (
      <span class:list={['w-4 h-1 rounded-full transition-colors', i <= dangerLevel ? 'bg-danger' : 'bg-line']} />
    ))}
    <span class="font-mono text-[11px] text-ink-faint ml-1.5">{dangerLevel}/5</span>
  </div>
</a>
