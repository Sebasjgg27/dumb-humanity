---
const nav = [
  { href: '/dumb-humanity/', label: 'Home' },
  { href: '/dumb-humanity/ladder/', label: 'The Ladder' },
  { href: '/dumb-humanity/tech/', label: 'Tech Tree' },
  { href: '/dumb-humanity/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur border-b border-rule no-print">
  <nav class="max-w-5xl mx-auto flex items-center gap-6 px-4 sm:px-8 h-14">
    <a href="/dumb-humanity/" class="font-serif font-bold text-lg tracking-tight flex items-center gap-2">
      <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
        <path d="M12 2 L4 6 V12 C4 17 7.5 20.5 12 22 C16.5 20.5 20 17 20 12 V6 Z" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M12 7 L12 16" stroke="#b45309" stroke-width="1.5" />
        <circle cx="12" cy="16" r="1.5" fill="#b45309" />
      </svg>
      Rebirth Manual
    </a>
    <div class="flex-1" />
    <ul class="hidden sm:flex items-center gap-5 text-sm">
      {
        nav.map((n) => (
          <li>
            <a href={n.href} class="text-ink-soft hover:text-ink transition-colors font-medium">
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/dumb-humanity/print/" class="hidden md:inline-flex text-sm px-3 py-1.5 rounded-md bg-amber-800 text-white hover:bg-amber-700 transition-colors font-medium">
      Print Packs
    </a>
  </nav>
</header>
