---
import type { Locale } from '../i18n/locales';
import { LOCALE_MAP } from '../i18n/locales';
import { href as i18nHref } from '../i18n/index';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  dict: any;
}

const { locale, dict } = Astro.props;
const localePath = `/dumb-humanity/${locale}`;
const navGroups = [
  {
    label: dict.nav.groupRestore,
    items: [
      { href: i18nHref(locale, '/'), label: dict.nav.home },
      { href: i18nHref(locale, '/survival/'), label: dict.nav.survival },
      { href: i18nHref(locale, '/science/'), label: dict.nav.science },
      { href: i18nHref(locale, '/engineering/'), label: dict.nav.engineering },
      { href: i18nHref(locale, '/medicine/'), label: dict.nav.medicine },
      { href: i18nHref(locale, '/agriculture/'), label: dict.nav.agriculture },
      { href: i18nHref(locale, '/industry/'), label: dict.nav.industry },
      { href: i18nHref(locale, '/library/'), label: dict.nav.library },
    ],
  },
  {
    label: dict.nav.groupEmergency,
    items: [
      { href: i18nHref(locale, '/emergency/'), label: dict.nav.emergencyHub },
      { href: i18nHref(locale, '/emergency/kits/'), label: dict.nav.kits },
      { href: i18nHref(locale, '/emergency/first-aid/'), label: dict.nav.firstAid },
      { href: i18nHref(locale, '/emergency/signals/'), label: dict.nav.signals },
      { href: i18nHref(locale, '/emergency/water-purification/'), label: dict.nav.waterPurification },
      { href: i18nHref(locale, '/emergency/shelter/'), label: dict.nav.shelter },
      { href: i18nHref(locale, '/emergency/food-foraging/'), label: dict.nav.foodForaging },
      { href: i18nHref(locale, '/emergency/evacuation/'), label: dict.nav.evacuation },
      { href: i18nHref(locale, '/emergency/communication/'), label: dict.nav.communication },
    ],
  },
  {
    label: dict.nav.groupScenarios,
    items: [
      { href: i18nHref(locale, '/scenarios/'), label: dict.nav.scenariosHub },
      { href: i18nHref(locale, '/scenarios/island/'), label: dict.nav.scenarioIsland },
      { href: i18nHref(locale, '/scenarios/desert/'), label: dict.nav.scenarioDesert },
      { href: i18nHref(locale, '/scenarios/arctic/'), label: dict.nav.scenarioArctic },
      { href: i18nHref(locale, '/scenarios/jungle/'), label: dict.nav.scenarioJungle },
      { href: i18nHref(locale, '/scenarios/mountain/'), label: dict.nav.scenarioMountain },
      { href: i18nHref(locale, '/scenarios/ocean/'), label: dict.nav.scenarioOcean },
      { href: i18nHref(locale, '/scenarios/urban-ruins/'), label: dict.nav.scenarioUrban },
      { href: i18nHref(locale, '/downloads/'), label: dict.nav.downloads },
    ],
  },
  {
    label: dict.nav.groupDisasters,
    items: [
      { href: i18nHref(locale, '/disasters/'), label: dict.nav.disastersHub },
      { href: i18nHref(locale, '/disasters/earthquake/'), label: dict.nav.disasterEarthquake },
      { href: i18nHref(locale, '/disasters/tsunami/'), label: dict.nav.disasterTsunami },
      { href: i18nHref(locale, '/disasters/hurricane/'), label: dict.nav.disasterHurricane },
      { href: i18nHref(locale, '/disasters/tornado/'), label: dict.nav.disasterTornado },
      { href: i18nHref(locale, '/disasters/flood/'), label: dict.nav.disasterFlood },
      { href: i18nHref(locale, '/disasters/volcano/'), label: dict.nav.disasterVolcano },
      { href: i18nHref(locale, '/disasters/blizzard/'), label: dict.nav.disasterBlizzard },
      { href: i18nHref(locale, '/disasters/nuclear/'), label: dict.nav.disasterNuclear },
      { href: i18nHref(locale, '/disasters/industrial/'), label: dict.nav.disasterIndustrial },
      { href: i18nHref(locale, '/disasters/pandemic/'), label: dict.nav.disasterPandemic },
    ],
  },
];
---

<header class="no-print sticky top-0 z-50 bg-navy text-navy-ink border-b border-white/10 shadow-sm">
  <div class="max-w-7xl mx-auto flex items-center gap-2 px-4 sm:px-6 h-14">
    <button
      type="button"
      id="sidebar-toggle"
      class="p-2 -ml-2 rounded-md hover:bg-white/10 text-navy-ink lg:hidden"
      aria-label={dict.aria.toggleSidebar}
      title={dict.aria.toggleSidebar}
    >
      <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>

    <a href={i18nHref(locale, '/')} class="flex items-center gap-2 min-w-0 shrink-0">
      <svg viewBox="0 0 24 24" class="w-6 h-6 shrink-0" aria-hidden="true">
        <path d="M12 3 L5 6.5 V13 C5 17 8 20 12 21 C16 20 19 17 19 13 V6.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M12 7.5 V14" stroke="#7fb0ff" stroke-width="1.4" stroke-linecap="round" />
        <circle cx="12" cy="14.5" r="1.2" fill="#7fb0ff" />
      </svg>
      <span class="font-semibold tracking-tight text-[15px] leading-tight hidden sm:inline">
        {dict.site.title}
      </span>
      <span class="font-semibold tracking-tight text-[15px] leading-tight sm:hidden">
        {dict.site.shortTitle}
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center min-w-0" aria-label={dict.aria.primaryNav}>
      {navGroups.map((group) => (
        <div class="nav-dropdown">
          <button class="nav-dropdown-trigger" type="button">
            {group.label}
            <svg viewBox="0 0 24 24" class="nav-chevron" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="nav-dropdown-menu">
            {group.items.map((n) => {
              const active = Astro.url.pathname === n.href || Astro.url.pathname === n.href + 'index.html';
              return (
                <a
                  href={n.href}
                  class:list={['nav-dropdown-item', active && 'active']}
                >
                  {n.label}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-1 ml-auto shrink-0">
      <LanguageSwitcher locale={locale} />

      <a
        href={i18nHref(locale, '/search/')}
        class="p-2 rounded-md hover:bg-white/10 text-navy-ink"
        aria-label={dict.aria.searchLibrary}
        title={dict.aria.searchLibrary}
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" stroke-linecap="round" />
        </svg>
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="p-2 rounded-md hover:bg-white/10 text-navy-ink"
        aria-label={dict.aria.toggleDarkMode}
        title={dict.aria.toggleDarkMode}
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg viewBox="0 0 24 24" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="lg:hidden border-t border-white/10 bg-navy/95 overflow-x-auto">
    <div class="px-4 py-1.5 min-w-max max-w-7xl mx-auto">
      {navGroups.map((group) => (
        <div class="mb-1">
          <span class="block text-[9px] font-bold uppercase tracking-wider text-white/30 px-2.5 pt-1.5">{group.label}</span>
          <div class="flex gap-0.5">
            {group.items.map((n) => (
              <a href={n.href} class="px-2.5 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 text-navy-ink/90 whitespace-nowrap">
                {n.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </nav>
</header>

<style>
  /* ── Dropdown container ── */
  .nav-dropdown {
    position: relative;
  }

  /* ── Trigger button ── */
  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.65rem;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--color-navy-ink, rgba(255,255,255,0.85));
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-dropdown-trigger:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .nav-chevron {
    width: 0.75rem;
    height: 0.75rem;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-dropdown:hover .nav-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Dropdown menu ── */
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 10rem;
    padding: 0.3rem;
    border-radius: 0.5rem;
    background: var(--color-surface, #1a2332);
    border: 1px solid var(--color-line, rgba(255,255,255,0.1));
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 1px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }

  .nav-dropdown:hover > .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition: opacity 0.15s ease 0.06s, transform 0.15s ease 0.06s, visibility 0s;
  }

  /* ── Menu item ── */
  .nav-dropdown-item {
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-navy-ink, rgba(255,255,255,0.8));
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.1s, color 0.1s;
  }
  .nav-dropdown-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .nav-dropdown-item.active {
    background-color: rgba(127, 176, 255, 0.15);
    color: #7fb0ff;
  }
</style>

<script>
  (() => {
    const root = document.documentElement;

    function applyTheme(pref: string) {
      if (pref === 'dark') root.classList.add('dark');
      else if (pref === 'light') root.classList.remove('dark');
      else root.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
    }
    applyTheme(localStorage.getItem('crp-theme') || 'system');

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = root.classList.contains('dark');
      root.classList.toggle('dark', !isDark);
      localStorage.setItem('crp-theme', isDark ? 'light' : 'dark');
    });

    document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
      document.body.classList.toggle('sidebar-open');
    });
    document.addEventListener('click', (e) => {
      if (document.body.classList.contains('sidebar-open')) {
        const target = e.target as HTMLElement;
        if (target.closest('.sidebar-backdrop')) {
          document.body.classList.remove('sidebar-open');
        }
      }
    });
  })();
</script>
