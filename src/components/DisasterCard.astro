---
import type { Dictionary } from '../i18n/index';

interface Props {
  id: string;
  title: string;
  type: 'natural' | 'man-made';
  dangerLevel: 1 | 2 | 3 | 4 | 5;
  href: string;
  dict: Dictionary;
}

const { id, title, type, dangerLevel, href, dict } = Astro.props;

const dangerColors: Record<number, string> = {
  1: 'bg-ok-soft text-ok',
  2: 'bg-blue-soft text-blue',
  3: 'bg-warn-soft text-warn',
  4: 'bg-warn-soft text-warn',
  5: 'bg-danger-soft text-danger',
};
const dangerLabel = dict.danger[['low', 'moderate', 'high', 'severe', 'extreme'][dangerLevel - 1] as keyof typeof dict.danger];

const typeLabel = type === 'natural' ? dict.disasters.natural : dict.disasters.manMade;
const typeColor = type === 'natural' ? 'bg-ok-soft text-ok' : 'bg-danger-soft text-danger';

const icons: Record<string, string> = {
  earthquake: '<path d="M2 12h2l2-4 3 8 2-6 2 4h2l2-3 1.5 3H22" stroke-linecap="round" stroke-linejoin="round"/>',
  tsunami: '<path d="M2 12c1-2 2.5-3 4-3s3 1 4 3 2.5 3 4 3 3-1 4-3 2.5-3 4-3" stroke-linecap="round"/><path d="M2 17c1-2 2.5-3 4-3s3 1 4 3 2.5 3 4 3 3-1 4-3 2.5-3 4-3" stroke-linecap="round"/>',
  hurricane: '<circle cx="12" cy="12" r="3"/><path d="M12 2a7 7 0 0 1 0 14M12 2a7 7 0 0 0 0 14M12 2v4M12 16v4M2 12h4M16 12h4" stroke-linecap="round"/>',
  tornado: '<path d="M4 4h16M6 8h12M8 12h8M10 16h4M11 20h2" stroke-linecap="round"/>',
  flood: '<path d="M3 17c1-2 2.5-3 4-3s3 1 4 3 2.5 3 4 3 3-1 4-3" stroke-linecap="round"/><path d="M3 12c1-2 2.5-3 4-3s3 1 4 3 2.5 3 4 3 3-1 4-3" stroke-linecap="round"/><path d="M12 3v4" stroke-linecap="round"/>',
  volcano: '<path d="M6 18h12M8 14l4-8 4 8" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 10c1-2 2-3 2-5M14 11c0-2 1-3 1-5" stroke-linecap="round"/>',
  blizzard: '<path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" stroke-linecap="round"/>',
  nuclear: '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" stroke-dasharray="3 3"/><path d="M12 4v2M12 18v2M4 12h2M18 12h2" stroke-linecap="round"/>',
  industrial: '<path d="M3 21h18M5 21V7l5-4v18M10 21V10l5-3v14M15 21V8l4-2v15" stroke-linecap="round" stroke-linejoin="round"/>',
  pandemic: '<circle cx="12" cy="8" r="3"/><circle cx="6" cy="14" r="1.5"/><circle cx="18" cy="14" r="1.5"/><circle cx="12" cy="18" r="1.5"/><circle cx="8" cy="11" r="1"/><circle cx="16" cy="11" r="1"/>',
};
---

<a href={href} class="card group p-6">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div class="w-10 h-10 rounded-md bg-danger-soft flex items-center justify-center shrink-0">
      <svg viewBox="0 0 24 24" class="w-5 h-5 text-danger" fill="none" stroke="currentColor" stroke-width="1.8">
        <Fragment set:html={icons[id] || icons.earthquake} />
      </svg>
    </div>
    <div class="flex items-center gap-2">
      <span class={`font-mono text-[9.5px] font-medium uppercase tracking-[0.1em] px-2 py-0.5 rounded-sm ${typeColor}`}>
        {typeLabel}
      </span>
      <span class={`font-mono text-[9.5px] font-medium uppercase tracking-[0.1em] px-2 py-0.5 rounded-sm ${dangerColors[dangerLevel]}`}>
        {dangerLabel}
      </span>
    </div>
  </div>
  <h3 class="font-serif text-[1.1rem] font-semibold tracking-tight mb-2">{title}</h3>
  <div class="flex items-center gap-2 mt-2">
    <span class="font-mono text-[11px] text-ink-faint">{dict.common.dangerLevel} {dangerLevel}/5</span>
    <div class="flex gap-0.5">
      {Array.from({ length: 5 }).map((_, i) => (
        <span class:list={['w-1.5 h-1.5 rounded-full', i < dangerLevel ? 'bg-danger' : 'bg-line']} />
      ))}
    </div>
  </div>
</a>
