---
import { LEVELS, techSlug } from '../data/levels';
import type { CollectionEntry } from 'astro:content';
import NodeCard from './NodeCard.astro';

interface Props {
  nodes: CollectionEntry<'tech'>[];
}

const { nodes } = Astro.props;

const nodesJson = nodes
  .sort((a, b) => a.data.level.localeCompare(b.data.level) || a.data.order - b.data.order)
  .map((n) => {
    const refId = (r: unknown) => (r as { id?: string }).id ?? (r as string);
    return {
      slug: techSlug(n.id),
      title: n.data.title,
      level: n.data.level,
      category: n.data.category,
      safety: n.data.safety,
      critical: n.data.critical,
      summary: n.body.slice(0, 160).replace(/#/g, '').replace(/\s+/g, ' ').trim(),
      prerequisites: n.data.prerequisites.map(refId),
    };
  });
---

<div
  id="tech-tree"
  class:list={['no-print']}
  data-nodes={JSON.stringify(nodesJson)}
  data-levels={JSON.stringify(LEVELS.map((l) => l.id))}
>
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <label class="text-sm font-medium text-ink-soft">Show levels:</label>
    <div class="flex flex-wrap gap-1.5" data-level-toggles>
      {
        LEVELS.map((l) => (
          <button
            type="button"
            data-level={l.id}
            class="text-xs font-semibold px-2.5 py-1 rounded-full border transition-colors"
            style={`border-color: ${l.color}; color: ${l.color}`}
          >
            {l.id}
          </button>
        ))
      }
    </div>
    <div class="flex-1" />
    <div class="flex gap-2">
      <button type="button" data-action="all" class="text-xs px-2.5 py-1 rounded-md bg-stone-100 hover:bg-stone-200 font-medium">All</button>
      <button type="button" data-action="done" class="text-xs px-2.5 py-1 rounded-md bg-stone-100 hover:bg-stone-200 font-medium">Hide done</button>
      <button type="button" data-action="reset" class="text-xs px-2.5 py-1 rounded-md bg-red-50 text-red-700 hover:bg-red-100 font-medium">Reset progress</button>
    </div>
  </div>

  <div id="tree-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      nodesJson.map((n) => (
        <NodeCard
          slug={n.slug}
          title={n.title}
          level={n.level}
          category={n.category}
          safety={n.safety}
          critical={n.critical}
          summary={n.summary}
        />
      ))
    }
  </div>
</div>

<style is:global>
  .tree-hidden {
    display: none !important;
  }
  .tree-done .tree-done-tag {
    display: inline-flex !important;
  }
</style>

<script>
(() => {
  const root = document.getElementById('tech-tree');
  const grid = document.getElementById('tree-grid');
  if (!root || !grid) return;

  const nodes: { slug: string; level: string; prerequisites: string[] }[] = JSON.parse(
    root.dataset.nodes || '[]'
  );
  const levelSet = new Set<string>(JSON.parse(root.dataset.levels || '[]'));
  const cards = new Map<string, HTMLElement>();
  grid.querySelectorAll<HTMLAnchorElement>('a[href^="/dumb-humanity/tech/"]').forEach((card) => {
    const slug = card.getAttribute('href')!.split('/').filter(Boolean).pop()!;
    cards.set(slug, card);
  });

  const STORAGE_KEY = 'rebirth-tech-progress';
  const done = new Set<string>(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));

  let activeLevels = new Set<string>(levelSet);
  let hideDone = false;

  function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...done]));
  }

  function apply() {
    for (const [slug, card] of cards) {
      const node = nodes.find((n) => n.slug === slug);
      const levelOk = node ? activeLevels.has(node.level) : true;
      const doneHidden = hideDone && done.has(slug);
      card.classList.toggle('tree-hidden', !levelOk || doneHidden);
      card.style.opacity = done.has(slug) ? '0.55' : '1';
    }
  }

  // Mark done nodes visually with a checkmark overlay
  function updateDoneTags() {
    for (const slug of done) {
      const card = cards.get(slug);
      if (!card) continue;
      let tag = card.querySelector('.tree-done-tag');
      if (!tag) {
        tag = document.createElement('span');
        tag.className =
          'tree-done-tag hidden absolute top-2 right-2 text-[10px] font-bold bg-green-100 text-green-800 rounded px-1.5 py-0.5';
        tag.textContent = '✓ done';
        card.classList.add('relative');
        card.appendChild(tag);
      }
    }
  }
  updateDoneTags();
  apply();

  root.querySelectorAll('[data-level]').forEach((btn) => {
    const level = (btn as HTMLElement).dataset.level!;
    btn.addEventListener('click', () => {
      if (activeLevels.has(level)) {
        activeLevels.delete(level);
      } else {
        activeLevels.add(level);
      }
      const active = activeLevels.has(level);
      (btn as HTMLElement).style.background = active ? levelColor(level) : 'transparent';
      (btn as HTMLElement).style.color = active ? '#fff' : levelColor(level);
      apply();
    });
    (btn as HTMLElement).style.background = levelColor(level);
    (btn as HTMLElement).style.color = '#fff';
  });

  function levelColor(level: string): string {
    const map: Record<string, string> = {
      A0: '#e11d48',
      A1: '#ea580c',
      A2: '#ca8a04',
      A3: '#16a34a',
      A4: '#2563eb',
      A5: '#7c3aed',
    };
    return map[level] || '#000';
  }

  root.querySelector('[data-action="all"]')!.addEventListener('click', () => {
    activeLevels = new Set<string>(levelSet);
    hideDone = false;
    apply();
  });

  root.querySelector('[data-action="done"]')!.addEventListener('click', () => {
    hideDone = !hideDone;
    apply();
  });

  root.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
    if (confirm('Reset all progress tracking on this device?')) {
      done.clear();
      save();
      window.location.reload();
    }
  });
})();
</script>
