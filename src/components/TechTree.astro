---
import { LEVELS, techSlug } from '../data/levels';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/locales';
import { getDictionary, href as i18nHref } from '../i18n/index';

interface Props {
  nodes: CollectionEntry<'tech'>[];
  locale: Locale;
}

const { nodes, locale } = Astro.props;
const dict = getDictionary(locale);
const techPrefix = i18nHref(locale, '/tech/').replace(/\/$/, '');

const refId = (r: unknown) => (r as { id?: string }).id ?? (r as string);

const COL_W = 220;
const NODE_W = 172;
const NODE_H = 30;
const ROW_H = 34;
const PAD_TOP = 24;
const PAD_LEFT = 16;

interface LayoutNode {
  slug: string;
  title: string;
  level: string;
  col: number;
  row: number;
  x: number;
  y: number;
  critical: boolean;
  prereqs: string[];
  missing: boolean;
}

const levelIndex = Object.fromEntries(LEVELS.map((l, i) => [l.id, i]));
const nodeMap = new Map<string, LayoutNode>();

const byLevel = new Map<string, CollectionEntry<'tech'>[]>();
for (const n of nodes) {
  if (!byLevel.has(n.data.level)) byLevel.set(n.data.level, []);
  byLevel.get(n.data.level)!.push(n);
}

for (const level of LEVELS) {
  const list = (byLevel.get(level.id) ?? []).sort((a, b) => a.data.order - b.data.order);
  list.forEach((n, i) => {
    nodeMap.set(techSlug(n.id), {
      slug: techSlug(n.id),
      title: n.data.title,
      level: n.data.level,
      col: levelIndex[n.data.level],
      row: i,
      x: PAD_LEFT + levelIndex[n.data.level] * COL_W,
      y: PAD_TOP + i * ROW_H,
      critical: n.data.critical,
      prereqs: n.data.prerequisites.map(refId),
      missing: n.data.prerequisites.some((p) => !nodeMap.has(refId(p))),
    });
  });
}

const layout = [...nodeMap.values()];
const maxRows = Math.max(...LEVELS.map((l) => (byLevel.get(l.id) ?? []).length));
const width = LEVELS.length * COL_W + PAD_LEFT * 2;
const height = maxRows * ROW_H + PAD_TOP + 20;

interface Edge { d: string; cls: string; src: string; dst: string }
const edges: Edge[] = [];
for (const node of layout) {
  for (const pre of node.prereqs) {
    const src = nodeMap.get(pre);
    if (!src) continue;
    const x1 = src.x + NODE_W;
    const y1 = src.y + NODE_H / 2;
    const x2 = node.x;
    const y2 = node.y + NODE_H / 2;
    const mx = (x1 + x2) / 2;
    edges.push({
      d: `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`,
      cls: 'edge',
      src: pre,
      dst: node.slug,
    });
  }
}

const nodesJson = JSON.stringify(layout);
const levelColors: Record<string, string> = {
  A0: '#2f9e44',
  A1: '#1d4ed8',
  A2: '#7c3aed',
  A3: '#e8590c',
  A4: '#0ca678',
  A5: '#5f3dc4',
};
---

<div class="tech-tree no-print" data-nodes={nodesJson} data-tech-prefix={techPrefix} data-reset-confirm={dict.techTree.resetConfirm}>
  <div class="flex flex-wrap items-center gap-4 mb-4">
    <div class="flex flex-wrap gap-3 text-[12px]">
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-ok"></span> {dict.techTree.legendMastered}</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-blue"></span> {dict.techTree.legendAvailable}</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-line-strong"></span> {dict.techTree.legendLocked}</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-warn"></span> {dict.techTree.legendCritical}</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-danger"></span> {dict.techTree.legendMissing}</span>
    </div>
    <div class="flex-1" />
    <button data-reset class="text-xs font-medium px-2.5 py-1 rounded-md border border-line bg-surface hover:border-danger hover:text-danger">
      {dict.techTree.resetProgress}
    </button>
  </div>

  <div class="overflow-x-auto rounded-lg border border-line bg-surface blueprint-grid-fine">
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      class="min-w-full"
      role="img"
      aria-label={dict.aria.techGraph}
    >
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-line-strong)" />
        </marker>
      </defs>

      {
        LEVELS.map((l, i) => (
          <g>
            <line
              x1={PAD_LEFT + i * COL_W + NODE_W / 2}
              y1={PAD_TOP - 16}
              x2={PAD_LEFT + i * COL_W + NODE_W / 2}
              y2={PAD_TOP - 8}
              stroke={levelColors[l.id]}
              stroke-width="2"
            />
            <text
              x={PAD_LEFT + i * COL_W + NODE_W / 2}
              y={PAD_TOP - 22}
              text-anchor="middle"
              class="tech-label"
              fill={levelColors[l.id]}
            >
              {l.id}
            </text>
          </g>
        ))
      }

      {edges.map((e) => (
        <path
          d={e.d}
          class={e.cls}
          data-from={e.src}
          data-to={e.dst}
          fill="none"
          stroke="var(--color-line-strong)"
          stroke-width="1.5"
          marker-end="url(#arrow)"
        />
      ))}

      {
        layout.map((n) => {
          const levelColor = levelColors[n.level] ?? '#888';
          return (
            <g
              class="tech-node"
              data-slug={n.slug}
              data-level={n.level}
              data-critical={n.critical ? '1' : '0'}
              data-missing={n.missing ? '1' : '0'}
              data-prereqs={JSON.stringify(n.prereqs)}
              transform={`translate(${n.x}, ${n.y})`}
              role="link"
              tabindex="0"
            >
              <rect
                width={NODE_W}
                height={NODE_H}
                rx="8"
                fill="var(--color-surface)"
                stroke="var(--color-line-strong)"
                stroke-width="1.5"
              />
              <line
                x1="0"
                y1="0"
                x2="0"
                y2={NODE_H}
                stroke={levelColor}
                stroke-width="4"
                rx="8"
              />
              {n.critical && (
                <circle cx={NODE_W - 8} cy="8" r="4" fill="var(--color-warn)" />
              )}
              {n.missing && (
                <circle cx={NODE_W - 8} cy="22" r="4" fill="var(--color-danger)" />
              )}
              <text
                x="10"
                y={NODE_H / 2 + 4}
                class="tech-node-title"
                fill="var(--color-ink)"
              >
                {n.title.length > 26 ? n.title.slice(0, 25) + '…' : n.title}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>
</div>

<style>
  .tech-node { cursor: pointer; }
  .tech-node:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; border-radius: 8px; }
  .tech-node rect { transition: stroke 0.15s ease, fill 0.15s ease; }
  .tech-node-title {
    font-size: 11px;
    font-weight: 500;
    font-family: var(--font-sans);
    pointer-events: none;
  }
  .tech-node.state-mastered rect { stroke: var(--color-ok); stroke-width: 2; fill: var(--color-ok-soft); }
  .tech-node.state-mastered .tech-node-title { fill: var(--color-ok); font-weight: 600; }
  .tech-node.state-available rect { stroke: var(--color-blue); }
  .tech-node.state-locked rect { opacity: 0.55; }
  .tech-node.state-missing rect { stroke: var(--color-danger); stroke-dasharray: 4 3; }
  .tech-node.state-critical rect { stroke: var(--color-warn); stroke-width: 2.5; }
  .edge.hl { stroke: var(--color-warn) !important; stroke-width: 2.5 !important; }
</style>

<script>
  (() => {
    const root = document.querySelector('.tech-tree');
    if (!root) return;
    const KEY = 'crp-mastered';
    let mastered = new Set<string>();
    try { mastered = new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { /* ignore */ }

    const nodes = Array.from(root.querySelectorAll<SVGGElement>('.tech-node'));

    function stateFor(el: SVGGElement): 'mastered' | 'available' | 'missing' | 'critical' | 'locked' {
      if (el.dataset.missing === '1') return 'missing';
      const prereqs: string[] = JSON.parse(el.dataset.prereqs || '[]');
      const allDone = prereqs.every((p) => mastered.has(p));
      if (allDone && mastered.has(el.dataset.slug || '')) return 'mastered';
      if (allDone) return el.dataset.critical === '1' ? 'critical' : 'available';
      return 'locked';
    }

    function apply() {
      nodes.forEach((el) => {
        el.classList.remove('state-mastered', 'state-available', 'state-critical', 'state-missing', 'state-locked');
        el.classList.add('state-' + stateFor(el));
      });
    }

    const edges = Array.from(root.querySelectorAll<SVGPathElement>('.edge'));
    function highlight(el: SVGGElement | null) {
      const slug = el?.dataset.slug;
      edges.forEach((e) => {
        const isTouch = e.dataset.from === slug || e.dataset.to === slug;
        e.classList.toggle('hl', !!isTouch);
      });
    }

    nodes.forEach((el) => {
      const open = () => {
    const prefix = root.getAttribute('data-tech-prefix') || '';
    window.location.href = `${prefix}/${el.dataset.slug}/`;
      };
      el.addEventListener('click', open);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
      el.addEventListener('mouseenter', () => highlight(el));
      el.addEventListener('mouseleave', () => highlight(null));
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      if (confirm(root.getAttribute('data-reset-confirm') || 'Reset all mastery progress on this device?')) {
        localStorage.removeItem(KEY);
        mastered = new Set();
        apply();
      }
    });

    apply();
  })();
</script>
