---
import { getCollection } from 'astro:content';
import { techSlug } from '../data/levels';
import { getTranslatedSidebar } from '../i18n/data';
import { href as i18nHref } from '../i18n/index';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  dict: any;
}

const { locale, dict } = Astro.props;
const SIDEBAR = getTranslatedSidebar(locale);

const tech = await getCollection('tech');
const bySlug = new Map(tech.map((t) => [techSlug(t.id), t]));
const byCategory = new Map<string, { id: string; title: string }[]>();
for (const t of tech) {
  const cat = t.data.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push({ id: techSlug(t.id), title: t.data.title });
}

const icons = {
  survival:
    '<path d="M3 20h18M6 20V8a6 6 0 0 1 12 0v12" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 20v-4h6v4" stroke-linecap="round"/>',
  science:
    '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 14h9" stroke-linecap="round"/>',
  engineering:
    '<circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2M7.8 7.8l1.4 1.4M14.8 14.8l1.4 1.4M16.2 7.8l-1.4 1.4M9.2 14.8l-1.4 1.4" stroke-linecap="round"/>',
  community:
    '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M13.5 12.5a4 4 0 0 1 7 2.5" stroke-linecap="round"/>',
};
---

<div class="sidebar-root">
  <nav aria-label={dict.aria.knowledgeTree} class="text-[13px]">
    <p class="tech-label text-ink-faint px-2 pb-3">{dict.sidebar.knowledgeTree}</p>

    {
      SIDEBAR.map((g) => {
        const count = g.subsections.reduce((acc, s) => acc + s.slugs.length, 0);
        return (
          <details class="sidebar-group" open={g.id === 'survival'}>
            <summary class="sidebar-group-toggle">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-blue shrink-0" fill="none" stroke="currentColor" stroke-width="1.8">
                <path set:html={icons[g.icon]} />
              </svg>
              <span class="flex-1 font-semibold">{g.label}</span>
              <span class="text-[11px] text-ink-faint font-normal tabular-nums">{count}</span>
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-ink-faint transition-transform duration-200 group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>

            <div class="sidebar-group-items">
              {
                g.subsections.map((sub) => {
                  const items = sub.slugs
                    .map((s) => bySlug.get(s))
                    .filter(Boolean)
                    .map((t) => ({ id: t!.id, title: t!.data.title }));
                  if (items.length === 0) return null;
                  return (
                    <details class="sidebar-subgroup" open>
                      <summary class="sidebar-subgroup-toggle">
                        <span class="flex-1">{sub.label}</span>
                        <span class="text-[11px] text-ink-faint tabular-nums">{items.length}</span>
                      </summary>
                      <ul class="sidebar-items">
                        {
                          items.map((it) => {
                            const itemHref = i18nHref(locale, `/tech/${it.id}/`);
                            const active = Astro.url.pathname === itemHref;
                            return (
                              <li>
                                <a
                                  href={itemHref}
                                  class:list={[
                                    'sidebar-link',
                                    active ? 'sidebar-link-active' : '',
                                  ]}
                                >
                                  {it.title}
                                </a>
                              </li>
                            );
                          })
                        }
                      </ul>
                    </details>
                  );
                })
              }
            </div>
          </details>
        );
      })
    }
  </nav>
</div>

<style>
  .sidebar-root summary::-webkit-details-marker {
    display: none;
  }
  .sidebar-root summary::marker {
    display: none;
    content: '';
  }

  .sidebar-group {
    margin-bottom: 0.25rem;
  }

  .sidebar-group-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem;
    border-radius: 0.375rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.15s;
  }
  .sidebar-group-toggle:hover {
    background-color: var(--color-blue-soft);
    color: var(--color-ink);
  }
  .sidebar-group-toggle::-webkit-details-marker {
    display: none;
  }
  .sidebar-group-toggle::marker {
    display: none;
    content: '';
  }

  .sidebar-group-items {
    padding-left: 0.75rem;
    margin-left: 0.625rem;
    border-left: 1px solid var(--color-line);
    margin-top: 0.25rem;
    padding-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-subgroup-toggle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition: background-color 0.15s, color 0.15s;
    font-size: 12.5px;
  }
  .sidebar-subgroup-toggle:hover {
    background-color: var(--color-blue-soft);
    color: var(--color-ink);
  }
  .sidebar-subgroup-toggle::-webkit-details-marker {
    display: none;
  }
  .sidebar-subgroup-toggle::marker {
    display: none;
    content: '';
  }

  .sidebar-items {
    margin-top: 0.125rem;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sidebar-link {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    border-left: 2px solid transparent;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
    color: var(--color-ink-soft);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .sidebar-link:hover {
    color: var(--color-blue);
    background-color: rgba(234, 240, 253, 0.6);
  }
  :global(.dark) .sidebar-link:hover {
    background-color: rgba(23, 36, 60, 0.6);
  }
  .sidebar-link-active {
    background-color: var(--color-blue-soft);
    color: var(--color-blue);
    border-left-color: var(--color-blue);
    font-weight: 500;
  }
</style>
