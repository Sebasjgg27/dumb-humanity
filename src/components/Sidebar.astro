---
import { SIDEBAR } from '../data/sidebar';
import { getCollection } from 'astro:content';
import { techSlug } from '../data/levels';

const tech = await getCollection('tech');
const bySlug = new Map(tech.map((t) => [techSlug(t.id), t]));
const byCategory = new Map<string, { id: string; title: string }[]>();
for (const t of tech) {
  const cat = t.data.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push({ id: techSlug(t.id), title: t.data.title });
}

const icons = {
  survival:
    '<path d="M3 20h18M6 20V8a6 6 0 0 1 12 0v12" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 20v-4h6v4" stroke-linecap="round"/>',
  science:
    '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 14h9" stroke-linecap="round"/>',
  engineering:
    '<circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2M7.8 7.8l1.4 1.4M14.8 14.8l1.4 1.4M16.2 7.8l-1.4 1.4M9.2 14.8l-1.4 1.4" stroke-linecap="round"/>',
  community:
    '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M13.5 12.5a4 4 0 0 1 7 2.5" stroke-linecap="round"/>',
};
---

<div class="sidebar-root">
  <nav aria-label="Knowledge tree" class="text-[13.5px]">
    <p class="tech-label text-ink-faint px-2 pb-2">Knowledge tree</p>

    {
      SIDEBAR.map((g) => {
        const count = g.subsections.reduce((acc, s) => acc + s.slugs.length, 0);
        return (
          <details class="group" open={g.id === 'survival'}>
            <summary
              class="flex items-center gap-2 px-2 py-2 rounded-md cursor-pointer list-none select-none hover:bg-blue-soft text-ink font-semibold"
            >
              <svg viewBox="0 0 24 24" class="w-[15px] h-[15px] text-blue shrink-0" fill="none" stroke="currentColor" stroke-width="1.8">
                <path set:html={icons[g.icon]} />
              </svg>
              <span class="flex-1">{g.label}</span>
              <span class="text-[11px] text-ink-faint font-normal">{count}</span>
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-ink-faint transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>

            <div class="pl-4 ml-2 border-l border-line mt-1 space-y-1 pb-1">
              {
                g.subsections.map((sub) => {
                  const items = sub.slugs
                    .map((s) => bySlug.get(s))
                    .filter(Boolean)
                    .map((t) => ({ id: t!.id, title: t!.data.title }));
                  if (items.length === 0) return null;
                  return (
                    <details class="group/sub" open>
                      <summary class="flex items-center gap-1.5 px-2 py-1 rounded cursor-pointer list-none select-none hover:bg-blue-soft text-ink-soft font-medium">
                        <span class="flex-1">{sub.label}</span>
                        <span class="text-[11px] text-ink-faint">{items.length}</span>
                        <svg viewBox="0 0 24 24" class="w-3 h-3 text-ink-faint transition-transform group-open/sub:rotate-90" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <ul class="mt-0.5 space-y-0.5">
                        {
                          items.map((it) => {
                            const active = Astro.url.pathname === `/dumb-humanity/tech/${it.id}/`;
                            return (
                              <li>
                                <a
                                  href={`/dumb-humanity/tech/${it.id}/`}
                                  class:list={[
                                    'block px-2 py-1 rounded-md border-l-2 transition-colors',
                                    active
                                      ? 'bg-blue-soft text-blue border-blue font-medium'
                                      : 'border-transparent text-ink-soft hover:text-blue hover:bg-blue-soft/60',
                                  ]}
                                >
                                  {it.title}
                                </a>
                              </li>
                            );
                          })
                        }
                      </ul>
                    </details>
                  );
                })
              }
            </div>
          </details>
        );
      })
    }
  </nav>
</div>

<style>
  .sidebar-root summary::-webkit-details-marker {
    display: none;
  }
</style>
