---
import { getCollection } from 'astro:content';
import { techSlug } from '../data/levels';
import { SIDEBAR } from '../data/sidebar';
import { getTranslatedSidebar } from '../i18n/data';
import { href as i18nHref } from '../i18n/index';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  dict: any;
}

const { locale, dict } = Astro.props;
const SIDEBAR_DATA = getTranslatedSidebar(locale);

const tech = await getCollection('tech');
const bySlug = new Map(tech.map((t) => [techSlug(t.id), t]));

const PAGE_LINKS: Record<string, { href: string; label: string }> = {
  'em-kits': { href: '/emergency/kits/', label: 'Survival Kits' },
  'em-firstaid': { href: '/emergency/first-aid/', label: 'First Aid' },
  'em-signals': { href: '/emergency/signals/', label: 'Signals' },
  'em-water': { href: '/emergency/water-purification/', label: 'Water Purification' },
  'em-shelter': { href: '/emergency/shelter/', label: 'Emergency Shelter' },
  'em-food': { href: '/emergency/food-foraging/', label: 'Food & Foraging' },
  'em-evac': { href: '/emergency/evacuation/', label: 'Evacuation' },
  'em-comms': { href: '/emergency/communication/', label: 'Communication' },
  'sc-island': { href: '/scenarios/island/', label: 'Island' },
  'sc-desert': { href: '/scenarios/desert/', label: 'Desert' },
  'sc-arctic': { href: '/scenarios/arctic/', label: 'Arctic' },
  'sc-jungle': { href: '/scenarios/jungle/', label: 'Jungle' },
  'sc-mountain': { href: '/scenarios/mountain/', label: 'Mountain' },
  'sc-ocean': { href: '/scenarios/ocean/', label: 'Ocean' },
  'sc-urban': { href: '/scenarios/urban-ruins/', label: 'Urban Ruins' },
  'd-earthquake': { href: '/disasters/earthquake/', label: 'Earthquake' },
  'd-tsunami': { href: '/disasters/tsunami/', label: 'Tsunami' },
  'd-hurricane': { href: '/disasters/hurricane/', label: 'Hurricane' },
  'd-tornado': { href: '/disasters/tornado/', label: 'Tornado' },
  'd-flood': { href: '/disasters/flood/', label: 'Flood' },
  'd-volcano': { href: '/disasters/volcano/', label: 'Volcanic Eruption' },
  'd-blizzard': { href: '/disasters/blizzard/', label: 'Blizzard' },
  'd-nuclear': { href: '/disasters/nuclear/', label: 'Nuclear Event' },
  'd-industrial': { href: '/disasters/industrial/', label: 'Industrial Accident' },
  'd-pandemic': { href: '/disasters/pandemic/', label: 'Pandemic' },
};

const SECTION_HUBS: Record<string, string> = {
  'emergency': '/emergency/',
  'scenarios': '/scenarios/',
  'disasters': '/disasters/',
};

const icons = {
  survival:
    '<path d="M3 20h18M6 20V8a6 6 0 0 1 12 0v12" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 20v-4h6v4" stroke-linecap="round"/>',
  science:
    '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 14h9" stroke-linecap="round"/>',
  engineering:
    '<circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2M7.8 7.8l1.4 1.4M14.8 14.8l1.4 1.4M16.2 7.8l-1.4 1.4M9.2 14.8l-1.4 1.4" stroke-linecap="round"/>',
  community:
    '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M13.5 12.5a4 4 0 0 1 7 2.5" stroke-linecap="round"/>',
  emergency:
    '<path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linecap="round" stroke-linejoin="round"/>',
  scenarios:
    '<path d="M12 22c-4.97 0-9-2.69-9-6s4.03-6 9-6 9 2.69 9 6-4.03 6-9 6z" stroke-linecap="round"/><path d="M9 10c0-1.66 1.34-3 3-3s3 1.34 3 3" stroke-linecap="round"/>',
  disasters:
    '<path d="M12 9v4M12 17h.01" stroke-linecap="round"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<div class="sidebar-root">
  <nav aria-label={dict.aria.knowledgeTree} class="text-[13px]">
    <p class="tech-label text-ink-faint px-2 pb-3">{dict.sidebar.knowledgeTree}</p>

    <ul class="nav-menu">
      {SIDEBAR_DATA.map((g) => {
        const count = g.subsections.reduce((acc, s) => acc + s.slugs.length, 0);
        return (
          <li class="nav-item">
            <button class="nav-button" type="button">
              <svg viewBox="0 0 24 24" class="nav-icon" fill="none" stroke="currentColor" stroke-width="1.8">
                <path set:html={icons[g.icon]} />
              </svg>
              <span class="flex-1 font-semibold">{g.label}</span>
              <span class="nav-count">{count}</span>
              <svg viewBox="0 0 24 24" class="nav-chevron" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <div class="nav-dropdown">
              <div class="nav-dropdown-inner">
                {SECTION_HUBS[g.id] && (
                  <a href={i18nHref(locale, SECTION_HUBS[g.id])} class="nav-dropdown-hub">
                    {g.label} {dict.common.home}
                  </a>
                )}

                {g.subsections.map((sub) => {
                  if (PAGE_LINKS[sub.id]) {
                    const page = PAGE_LINKS[sub.id];
                    const itemHref = i18nHref(locale, page.href);
                    const active = Astro.url.pathname === itemHref;
                    return (
                      <a href={itemHref} class:list={['nav-dropdown-link', active && 'active']}>
                        {sub.label}
                      </a>
                    );
                  }

                  const items = sub.slugs
                    .map((s) => bySlug.get(s))
                    .filter(Boolean)
                    .map((t) => ({ id: techSlug(t!.id), title: t!.data.title }));

                  if (items.length === 0) return null;

                  return (
                    <div class="nav-dropdown-group">
                      <span class="nav-dropdown-group-label">{sub.label}</span>
                      <ul>
                        {items.map((it) => {
                          const itemHref = i18nHref(locale, `/tech/${it.id}/`);
                          const active = Astro.url.pathname === itemHref;
                          return (
                            <li>
                              <a href={itemHref} class:list={['nav-dropdown-link', active && 'active']}>
                                {it.title}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  );
                })}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </nav>
</div>

<style>
  .nav-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    position: relative;
  }

  /* ── Section button ── */
  .nav-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.5rem;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-button:hover {
    background-color: var(--color-blue-soft);
    color: var(--color-ink);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .nav-count {
    font-size: 11px;
    font-weight: 400;
    color: var(--color-ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .nav-chevron {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-ink-faint);
    transition: transform 0.2s ease;
  }
  .nav-item:hover .nav-chevron,
  .nav-item:focus-within .nav-chevron {
    transform: rotate(90deg);
  }

  /* ── Dropdown panel ── */
  .nav-dropdown {
    position: relative;
    z-index: 50;
    height: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 0.15s ease 0.08s, height 0.2s ease;
    pointer-events: none;
  }

  .nav-item:hover > .nav-dropdown,
  .nav-item:focus-within > .nav-dropdown {
    height: auto;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.15s ease 0.12s, height 0s;
  }

  .nav-dropdown-inner {
    padding: 0.25rem 0 0.5rem 0.5rem;
    margin-left: 0.75rem;
    border-left: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  /* ── Hub link ── */
  .nav-dropdown-hub {
    display: block;
    padding: 0.3rem 0.5rem;
    border-radius: 0.25rem;
    font-weight: 600;
    font-size: 12.5px;
    color: var(--color-blue);
    text-decoration: none;
    transition: background-color 0.12s;
  }
  .nav-dropdown-hub:hover {
    background-color: var(--color-blue-soft);
  }

  /* ── Grouped subcategory ── */
  .nav-dropdown-group {
    margin-top: 0.125rem;
  }
  .nav-dropdown-group-label {
    display: block;
    padding: 0.3rem 0.5rem;
    font-weight: 500;
    font-size: 12px;
    color: var(--color-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .nav-dropdown-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  /* ── Individual link ── */
  .nav-dropdown-link {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    border-left: 2px solid transparent;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
  }
  .nav-dropdown-link:hover {
    color: var(--color-blue);
    background-color: rgba(234, 240, 253, 0.6);
  }
  :global(.dark) .nav-dropdown-link:hover {
    background-color: rgba(23, 36, 60, 0.6);
  }
  .nav-dropdown-link.active {
    background-color: var(--color-blue-soft);
    color: var(--color-blue);
    border-left-color: var(--color-blue);
    font-weight: 500;
  }
</style>
