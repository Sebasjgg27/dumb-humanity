---
import { LEVEL_BY_ID } from '../data/levels';
import { stageFor } from '../data/stages';
import { getTranslatedStages, getTranslatedSafety } from '../i18n/data';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { getDictionary, href as i18nHref } from '../i18n/index';

interface Props {
  slug: string;
  title: string;
  level: string;
  category: string;
  safety: string;
  critical?: boolean;
  summary?: string;
  difficulty?: number;
  locale?: Locale;
}

const { slug, title, level, safety, critical, summary } = Astro.props;
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const dict = getDictionary(locale);
const lvl = LEVEL_BY_ID[level as keyof typeof LEVEL_BY_ID];
const stage = getTranslatedStages(locale).find((s) => s.id === stageFor(slug).id) ?? stageFor(slug);
const safetyMeta = getTranslatedSafety(locale);
const safetyLabel = safetyMeta[safety]?.label ?? safety;

const safetyColor: Record<string, string> = {
  LOW: 'bg-ok-soft text-ok',
  MODERATE: 'bg-warn-soft text-warn',
  HIGH: 'bg-warn-soft text-warn',
  EXTREME: 'bg-danger-soft text-danger',
};
---

<a
  href={i18nHref(locale ?? 'en', `/tech/${slug}/`)}
  class="card group p-5"
>
  <div class="flex items-start justify-between gap-2 mb-2">
    <h3 class="font-serif text-[1.06rem] font-semibold leading-snug tracking-tight">{title}</h3>
    {critical && (
      <span class="shrink-0 font-mono text-[9.5px] font-medium uppercase tracking-[0.12em] bg-warn-soft text-warn rounded-sm px-1.5 py-1">
        {dict.common.core}
      </span>
    )}
  </div>

  {summary && <p class="text-[13.5px] text-ink-soft line-clamp-2 leading-relaxed mb-4">{summary}</p>}

  <div class="flex items-center gap-1.5 flex-wrap">
    <span class="font-mono text-[10.5px] tracking-wide px-1.5 py-0.5 rounded-sm border" style={`border-color: ${lvl.color}55; color: ${lvl.color}`}>
      {level}
    </span>
    <span class="text-[11px] px-1.5 py-0.5 rounded-sm bg-blue-soft text-blue font-medium">{stage.name}</span>
    <span class:list={['text-[11px] px-1.5 py-0.5 rounded-sm font-medium', safetyColor[safety] ?? 'bg-bg text-ink-soft']}>
      {safetyLabel}
    </span>
  </div>
</a>
