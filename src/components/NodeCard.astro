---
import { LEVEL_BY_ID } from '../data/levels';
import { difficultyFor, stageFor } from '../data/stages';

interface Props {
  slug: string;
  title: string;
  level: string;
  category: string;
  safety: string;
  critical?: boolean;
  summary?: string;
  difficulty?: number;
}

const { slug, title, level, safety, critical, summary } = Astro.props;
const lvl = LEVEL_BY_ID[level as keyof typeof LEVEL_BY_ID];
const stage = stageFor(slug);
const diff = Astro.props.difficulty ?? difficultyFor(slug, level);

const safetyColor: Record<string, string> = {
  LOW: 'bg-ok-soft text-ok',
  MODERATE: 'bg-warn-soft text-warn',
  HIGH: 'bg-warn-soft text-warn',
  EXTREME: 'bg-danger-soft text-danger',
};
---

<a
  href={`/dumb-humanity/tech/${slug}/`}
  class="group block rounded-lg border border-line bg-surface p-4 transition-all hover:border-blue/50 hover:shadow-sm"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold leading-snug group-hover:text-blue">{title}</h3>
    {critical && (
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide bg-warn-soft text-warn rounded px-1.5 py-0.5">
        Core
      </span>
    )}
  </div>
  {summary && <p class="text-[13px] text-ink-soft mt-1.5 line-clamp-2 leading-relaxed">{summary}</p>}

  <div class="flex flex-wrap items-center gap-1.5 mt-3 text-[11px]">
    <span class="font-mono px-1.5 py-0.5 rounded border" style={`border-color: ${lvl.color}55; color: ${lvl.color}`}>
      {level}
    </span>
    <span class="px-1.5 py-0.5 rounded bg-blue-soft text-blue font-medium">{stage.name}</span>
    <span class="px-1.5 py-0.5 rounded bg-bg text-ink-soft border border-line">
      Diff {diff}/5
    </span>
    <span class:list={['px-1.5 py-0.5 rounded font-medium', safetyColor[safety] ?? 'bg-bg text-ink-soft']}>
      {safety}
    </span>
  </div>
</a>
