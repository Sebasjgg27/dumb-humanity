---
import { LEVEL_BY_ID } from '../data/levels';

interface Props {
  slug: string;
  title: string;
  level: string;
  category: string;
  safety: string;
  critical?: boolean;
  summary?: string;
  done?: boolean;
}

const { slug, title, level, category, safety, critical, summary, done } = Astro.props;
const lvl = LEVEL_BY_ID[level as keyof typeof LEVEL_BY_ID];

const safetyColor: Record<string, string> = {
  LOW: 'bg-green-100 text-green-800',
  MODERATE: 'bg-amber-100 text-amber-800',
  HIGH: 'bg-orange-100 text-orange-800',
  EXTREME: 'bg-red-100 text-red-900',
};
---

<a
  href={`/dumb-humanity/tech/${slug}/`}
  class:list={[
    'group block rounded-lg border border-line bg-white p-3.5 transition-all hover:border-amber-700/50 hover:shadow-sm',
    done && 'opacity-60',
  ]}
>
  <div class="flex items-start justify-between gap-2">
    <p class="font-serif font-bold leading-snug group-hover:text-amber-800">{title}</p>
    {
      critical && (
        <span class="shrink-0 text-[10px] font-bold uppercase tracking-wide bg-rose-100 text-rose-700 rounded px-1.5 py-0.5">
          Core
        </span>
      )
    }
  </div>
  {
    summary && <p class="text-sm text-ink-soft mt-1.5 line-clamp-2">{summary}</p>
  }
  <div class="flex flex-wrap items-center gap-1.5 mt-3 text-[11px]">
    <span class="font-semibold px-1.5 py-0.5 rounded" style={`background: ${lvl.color}1a; color: ${lvl.color}`}>
      {level}
    </span>
    <span class="px-1.5 py-0.5 rounded bg-stone-100 text-stone-700">{category}</span>
    <span class:list={['px-1.5 py-0.5 rounded font-medium', safetyColor[safety]]}>Risk: {safety}</span>
  </div>
</a>
