---
import { LEVELS, type Level } from '../data/levels';
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/locales';
import { getTranslatedLevels } from '../i18n/data';
import { getDictionary, href as i18nHref } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const tech = await getCollection('tech');
const levels = getTranslatedLevels(locale);

function countFor(level: Level): number {
  return tech.filter((t) => t.data.level === level).length;
}
---

<nav aria-label={dict.aria.rebuildLadder} class="text-sm">
  <p class="tech-label text-ink-faint mb-3 px-2">
    {dict.ladder.title}
  </p>
  <ul class="space-y-1">
    {
      levels.map((l) => {
        const active = Astro.url.pathname.includes(`/ladder/${l.id}/`);
        return (
          <li>
            <a
              href={i18nHref(locale, `/ladder/${l.id}/`)}
              class:list={[
                'flex items-center gap-2 px-2.5 py-1.5 rounded-md transition-colors',
                active ? 'bg-navy text-navy-ink' : 'text-ink-soft hover:bg-bg hover:text-ink',
              ]}
            >
              <span
                class="w-2.5 h-2.5 rounded-full shrink-0"
                style={`background: ${l.color}`}
              />
              <span class="font-semibold shrink-0">{l.id}</span>
              <span class="truncate">{l.name}</span>
              <span class:list={['ml-auto font-mono text-[11px]', active ? 'text-navy-ink/70' : 'text-ink-faint']}>
                {countFor(l.id)}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
