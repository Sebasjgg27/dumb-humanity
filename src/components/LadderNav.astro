---
import { LEVELS, type Level } from '../data/levels';
import { getCollection } from 'astro:content';

const tech = await getCollection('tech');

function countFor(level: Level): number {
  return tech.filter((t) => t.data.level === level).length;
}
---

<nav aria-label="Rebuild ladder" class="text-sm">
  <p class="font-semibold uppercase tracking-wider text-xs text-ink-soft mb-3 px-2">
    The Rebuild Ladder
  </p>
  <ul class="space-y-1">
    {
      LEVELS.map((l) => {
        const active = Astro.url.pathname === `/dumb-humanity/ladder/${l.id}/`;
        return (
          <li>
            <a
              href={`/dumb-humanity/ladder/${l.id}/`}
              class:list={[
                'flex items-center gap-2 px-2 py-1.5 rounded-md transition-colors',
                active ? 'bg-amber-800 text-white' : 'text-ink-soft hover:bg-amber-900/10',
              ]}
            >
              <span
                class="w-2.5 h-2.5 rounded-full shrink-0"
                style={`background: ${l.color}`}
              />
              <span class="font-semibold shrink-0">{l.id}</span>
              <span class="truncate">{l.name}</span>
              <span class:list={['ml-auto text-xs', active ? 'text-white/80' : 'text-ink-soft/60']}>
                {countFor(l.id)}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
