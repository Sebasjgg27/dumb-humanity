---
import { LOCALES, type Locale } from '../i18n/locales';
import { href } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/dumb-humanity\/(en|es|fr|zh|ar|pt)/, '') || '/';
---

<div class="relative" id="lang-switcher">
  <button
    type="button"
    id="lang-btn"
    class="flex items-center gap-1.5 px-2 py-1.5 rounded-md text-[12px] font-medium hover:bg-white/10 text-navy-ink/85 transition-colors"
    aria-label="Change language"
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
    </svg>
    <span class="hidden sm:inline">{LOCALES.find(l => l.code === locale)?.nativeName}</span>
    <svg viewBox="0 0 24 24" class="w-3 h-3 text-navy-ink/50" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <ul
    id="lang-menu"
    class="hidden absolute right-0 top-full mt-1 bg-navy border border-white/10 rounded-lg shadow-lg py-1 z-50 min-w-[160px]"
    role="listbox"
    aria-label="Select language"
  >
    {LOCALES.map((l) => (
      <li role="option" aria-selected={l.code === locale}>
        <a
          href={href(l.code, currentPath)}
          class:list={[
            'flex items-center gap-2 px-3 py-2 text-[13px] transition-colors',
            l.code === locale
              ? 'bg-white/15 text-white font-medium'
              : 'text-navy-ink/80 hover:bg-white/10 hover:text-white',
          ]}
        >
          <span>{l.flag}</span>
          <span>{l.nativeName}</span>
          {l.code === locale && (
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 ml-auto text-blue" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  (() => {
    const btn = document.getElementById('lang-btn');
    const menu = document.getElementById('lang-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    });

    menu.addEventListener('click', (e) => e.stopPropagation());
  })();
</script>
