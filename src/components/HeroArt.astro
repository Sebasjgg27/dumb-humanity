---
/**
 * HeroArt — editorial plate for the homepage hero.
 * Pure geometry (no text) so it needs no translation.
 * Uses CSS variables, so it follows the light/dark palette.
 */
---

<svg
  viewBox="0 0 520 520"
  class="hero-art w-full h-auto"
  aria-hidden="true"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Registration / crop marks -->
  <g stroke="var(--color-line-strong)" stroke-width="1">
    <path d="M18 44V18h26" />
    <path d="M502 44V18h-26" />
    <path d="M18 476v26h26" />
    <path d="M502 476v26h-26" />
  </g>

  <!-- Outer dial -->
  <circle cx="260" cy="260" r="230" stroke="var(--color-line)" stroke-width="1" />
  <circle cx="260" cy="260" r="216" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="1 7" />

  <!-- Tick marks -->
  <g stroke="var(--color-ink-faint)" stroke-width="1" opacity="0.7">
    <line x1="260" y1="22" x2="260" y2="42" transform="rotate(0 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(30 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(60 260 260)" />
    <line x1="260" y1="22" x2="260" y2="42" transform="rotate(90 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(120 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(150 260 260)" />
    <line x1="260" y1="22" x2="260" y2="42" transform="rotate(180 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(210 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(240 260 260)" />
    <line x1="260" y1="22" x2="260" y2="42" transform="rotate(270 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(300 260 260)" />
    <line x1="260" y1="22" x2="260" y2="36" transform="rotate(330 260 260)" />
  </g>

  <!-- Arc accents (drawn in) -->
  <circle class="hero-arc arc-a" cx="260" cy="260" r="196" stroke="var(--color-blue)" stroke-width="1.5"
    stroke-dasharray="340 888" stroke-linecap="round" transform="rotate(-115 260 260)" />
  <circle class="hero-arc arc-b" cx="260" cy="260" r="176" stroke="var(--color-blue)" stroke-width="1"
    stroke-dasharray="180 926" stroke-linecap="round" opacity="0.55" transform="rotate(50 260 260)" />
  <circle class="hero-arc arc-c" cx="260" cy="260" r="206" stroke="var(--color-ink)" stroke-width="1"
    stroke-dasharray="90 1206" stroke-linecap="round" opacity="0.35" transform="rotate(140 260 260)" />

  <!-- Knowledge graph: outer nodes -->
  <g stroke="var(--color-line-strong)" stroke-width="1">
    <line x1="260" y1="150" x2="260" y2="90" />
    <line x1="355" y1="315" x2="430" y2="260" />
    <line x1="260" y1="370" x2="260" y2="430" />
    <line x1="165" y1="315" x2="90" y2="260" />
    <line x1="165" y1="205" x2="118" y2="140" />
    <line x1="355" y1="205" x2="402" y2="140" />
  </g>

  <!-- Knowledge graph: inner ring + spokes -->
  <g stroke="var(--color-ink-faint)" stroke-width="1" opacity="0.55">
    <line x1="260" y1="260" x2="260" y2="150" />
    <line x1="260" y1="260" x2="355" y2="205" />
    <line x1="260" y1="260" x2="355" y2="315" />
    <line x1="260" y1="260" x2="260" y2="370" />
    <line x1="260" y1="260" x2="165" y2="315" />
    <line x1="260" y1="260" x2="165" y2="205" />
    <path d="M260 150 L355 205 L355 315 L260 370 L165 315 L165 205 Z" opacity="0.6" />
  </g>

  <!-- Nodes -->
  <g class="hero-nodes">
    <circle cx="260" cy="90" r="4" fill="var(--color-navy)" />
    <circle cx="430" cy="260" r="4" fill="var(--color-navy)" />
    <circle cx="260" cy="430" r="4" fill="var(--color-navy)" />
    <circle cx="90" cy="260" r="4" fill="var(--color-navy)" />
    <circle cx="118" cy="140" r="3" fill="var(--color-ink-faint)" />
    <circle cx="402" cy="140" r="3" fill="var(--color-ink-faint)" />
    <circle cx="260" cy="150" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
    <circle cx="355" cy="205" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
    <circle cx="355" cy="315" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
    <circle cx="260" cy="370" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
    <circle cx="165" cy="315" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
    <circle cx="165" cy="205" r="4.5" fill="var(--color-surface)" stroke="var(--color-blue)" stroke-width="1.5" />
  </g>

  <!-- Central emblem: the shield mark -->
  <g transform="translate(260 260) scale(4.6) translate(-12 -12)" stroke-linejoin="round">
    <path d="M12 3 L5 6.5 V13 C5 17 8 20 12 21 C16 20 19 17 19 13 V6.5 Z"
      fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="1.1" vector-effect="non-scaling-stroke" />
    <path d="M12 7.5 V14" stroke="var(--color-blue)" stroke-width="1.2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    <circle cx="12" cy="14.5" r="1.3" fill="var(--color-blue)" />
  </g>

  <!-- Engraved hatch, lower left -->
  <g stroke="var(--color-line-strong)" stroke-width="1" opacity="0.8">
    <path d="M40 400 L84 444" />
    <path d="M40 384 L100 444" />
    <path d="M40 368 L116 444" />
    <path d="M40 352 L132 444" />
    <path d="M40 336 L148 444" opacity="0.5" />
    <path d="M40 320 L164 444" opacity="0.25" />
  </g>
</svg>

<style>
  .hero-art {
    color: var(--color-ink);
  }

  .hero-arc {
    stroke-dashoffset: 0;
    animation: hero-draw 2.2s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  .arc-b { animation-delay: 0.25s; }
  .arc-c { animation-delay: 0.45s; }

  .hero-nodes > circle {
    animation: rise 0.9s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: 0.7s;
  }
  .hero-nodes > circle:nth-child(2n) { animation-delay: 0.85s; }
  .hero-nodes > circle:nth-child(3n) { animation-delay: 1s; }

  @keyframes hero-draw {
    from {
      stroke-dashoffset: 1300;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
