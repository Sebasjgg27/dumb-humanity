---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { LEVELS, techSlug } from '../data/levels';
import NodeCard from '../components/NodeCard.astro';

const tech = await getCollection('tech');
const byLevel = (level: string) =>
  tech.filter((t) => t.data.level === level).sort((a, b) => a.data.order - b.data.order);
const a0 = byLevel('A0');
const featured = ['water', 'fire', 'charcoal', 'iron_smelting', 'sulfuric_acid', 'steam_engine']
  .map((slug) => tech.find((t) => techSlug(t.id) === slug))
  .filter(Boolean);
const summary = (n: (typeof tech)[number]) => n.body.slice(0, 140).replace(/#/g, '').replace(/\s+/g, ' ').trim();
---

<BaseLayout title="Rebirth Manual" sidebar={false}>
  <section class="text-center py-12 md:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700 mb-3">
      A practical manual for restarting civilization
    </p>
    <h1 class="font-serif text-4xl md:text-6xl font-bold tracking-tight">
      What do we need<br class="hidden md:block" />
      to build <span class="text-amber-700">everything</span> again?
    </h1>
    <p class="text-lg text-ink-soft max-w-2xl mx-auto mt-5 leading-relaxed">
      From a campfire to a steam engine to a radio — a step-by-step technology tree
      for rebooting human civilization, in the spirit of <em>Dr. Stone</em> and the
      real science of knowledge recovery.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a href="/dumb-humanity/ladder/" class="px-5 py-2.5 rounded-lg bg-amber-800 text-white font-semibold hover:bg-amber-700 transition-colors">
        Explore the Ladder
      </a>
      <a href="/dumb-humanity/tech/" class="px-5 py-2.5 rounded-lg border border-rule bg-white font-semibold hover:border-amber-700/50 transition-colors">
        Open the Tech Tree
      </a>
    </div>
  </section>

  <section class="mt-6">
    <h2 class="font-serif text-2xl font-bold mb-1">The six stages</h2>
    <p class="text-ink-soft mb-6">Every stage answers one question. Climb them in order — each unlocks the next.</p>
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
      {
        LEVELS.map((l) => (
          <a
            href={`/dumb-humanity/ladder/${l.id}/`}
            class="group rounded-xl border border-line bg-white p-5 hover:border-amber-700/40 hover:shadow-sm transition-all"
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="w-3 h-3 rounded-full" style={`background: ${l.color}`}></span>
              <span class="text-xs font-bold" style={`color: ${l.color}`}>{l.id}</span>
            </div>
            <h3 class="font-serif font-bold text-lg group-hover:text-amber-800">{l.name}</h3>
            <p class="text-sm text-ink-soft mt-1">{l.question}</p>
            <p class="text-xs mt-3 text-ink-soft/70">{l.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-end justify-between mb-5">
      <div>
        <h2 class="font-serif text-2xl font-bold">Start here: Survival Baseline</h2>
        <p class="text-ink-soft">The first eleven technologies — the floor under everything.</p>
      </div>
      <a href="/dumb-humanity/ladder/A0/" class="text-sm font-semibold text-amber-800 hover:underline shrink-0">View all A0 →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {
        a0.map((n) => (
          <NodeCard
            slug={techSlug(n.id)}
            title={n.data.title}
            level={n.data.level}
            category={n.data.category}
            safety={n.data.safety}
            critical={n.data.critical}
            summary={summary(n)}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-12 print-break">
    <div class="rounded-xl border border-amber-800/30 bg-amber-50 p-6">
      <h2 class="font-serif text-xl font-bold mb-3">Key deep dives</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {
          featured.map((n) => n && (
            <NodeCard
              slug={techSlug(n.id)}
              title={n.data.title}
              level={n.data.level}
              category={n.data.category}
              safety={n.data.safety}
              critical={n.data.critical}
              summary={summary(n)}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
