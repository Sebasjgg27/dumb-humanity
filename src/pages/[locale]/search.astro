---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NodeCard from '../../components/NodeCard.astro';
import { getCollection } from 'astro:content';
import { techSlug } from '../../data/levels';
import { LOCALES, type Locale } from '../../i18n/locales';
import { getDictionary } from '../../i18n/index';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const tech = await getCollection('tech');
const summary = (n: (typeof tech)[number]) => n.body.slice(0, 160).replace(/#/g, '').replace(/\s+/g, ' ').trim();

const cards = tech
  .map((n) => ({
    slug: techSlug(n.id),
    title: n.data.title,
    level: n.data.level,
    category: n.data.category,
    safety: n.data.safety,
    critical: n.data.critical,
    summary: summary(n),
    text: (n.data.title + ' ' + n.data.category + ' ' + n.data.materials.join(' ')).toLowerCase(),
  }))
  .sort((a, b) => a.level.localeCompare(b.level) || a.title.localeCompare(b.title));
---

<BaseLayout title={dict.search.title} description={dict.search.subtitle} locale={locale}>
  <header class="mb-8">
    <p class="tech-label text-blue mb-2">{dict.search.tagline}</p>
    <h1 class="font-serif text-3xl md:text-4xl font-bold tracking-tight">{dict.search.title}</h1>
    <p class="text-ink-soft mt-3 max-w-2xl">{dict.search.subtitle}</p>
  </header>

  <div class="relative mb-6 no-print">
    <svg viewBox="0 0 24 24" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-ink-faint" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.3-4.3" stroke-linecap="round" />
    </svg>
    <input
      id="search-input"
      type="search"
      autofocus
      placeholder={dict.search.searchPlaceholder}
      class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-line-strong bg-surface text-sm focus:outline-none focus:ring-2 focus:ring-blue/40"
    />
  </div>

  <p id="search-count" class="text-xs text-ink-faint mb-4 font-mono">{cards.length} {dict.common.articles}</p>

  <div id="search-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" data-cards={JSON.stringify(cards)}>
    {
      cards.map((c) => (
        <NodeCard locale={locale}
          slug={c.slug}
          title={c.title}
          level={c.level}
          category={c.category}
          safety={c.safety}
          critical={c.critical}
          summary={c.summary}
        />
      ))
    }
  </div>

  <script>
    (() => {
      const grid = document.getElementById('search-grid') as HTMLElement | null;
      if (!grid) return;
      const cards: { slug: string; title: string; text: string; summary: string }[] =
        JSON.parse(grid.dataset.cards || '[]');
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const countEl = document.getElementById('search-count');
      const empty = document.createElement('p');

      function tokenize(q: string): string[] {
        return q.toLowerCase().replace(/[^a-z0-9_]+/g, ' ').split(' ').filter(Boolean);
      }

      function apply() {
        if (!grid) return;
        const tokens = tokenize(input?.value || '');
        const visible = cards.filter((c) => tokens.every((t) => c.text.includes(t)));
        grid.querySelectorAll<HTMLElement>('a[href*="/tech/"]').forEach((a) => {
          const slug = a.getAttribute('href')!.split('/').filter(Boolean).pop()!;
          a.classList.toggle('hidden', !visible.some((c) => c.slug === slug));
        });
        if (countEl) countEl.textContent = visible.length === cards.length ? `${cards.length} articles` : `${visible.length} of ${cards.length} articles`;
        empty.textContent = visible.length ? '' : 'No articles match. Try a broader keyword, or start at the Library.';
        empty.className = visible.length ? 'hidden' : 'text-sm text-ink-soft py-8 text-center';
      }

      input?.addEventListener('input', apply);
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') apply();
      });
      grid.insertAdjacentElement('beforebegin', empty);
    })();
  </script>
</BaseLayout>
