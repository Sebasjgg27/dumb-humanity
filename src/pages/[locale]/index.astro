---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslatedStages } from '../../i18n/data';
import { getLocalTech } from '../../i18n/content';
import { LOCALES, type Locale } from '../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../i18n/index';
import NodeCard from '../../components/NodeCard.astro';
import HeroArt from '../../components/HeroArt.astro';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const stages = getTranslatedStages(locale);

const tech = await getLocalTech(locale, 130);
const bySlug = (s: string) => tech.find((t) => t.slug === s);

const featured = ['water', 'fire', 'charcoal', 'iron_smelting', 'sulfuric_acid', 'steam_engine']
  .map((s) => bySlug(s))
  .filter(Boolean);

const homeStages = stages.slice(0, 6);

const stats = [
  { value: tech.length, label: dict.home.statsArticles },
  { value: 'A0 → A5', label: dict.home.statsStages },
  { value: '100%', label: dict.home.statsOffline },
  { value: '0', label: dict.home.statsDeps },
];
---

<BaseLayout title={dict.site.title} description={dict.site.description} sidebar={false} locale={locale}>
  <!-- ── Hero: editorial spread ── -->
  <section class="blueprint-grid border-b border-line -mx-5 sm:-mx-8 lg:-mx-12 xl:-mx-16 px-5 sm:px-8 lg:px-12 xl:px-16 bg-surface relative overflow-hidden">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 xl:gap-16 items-center py-16 md:py-24">
      <div>
        <p class="tech-label text-blue mb-6 rise rise-1">{dict.home.heroTagline}</p>
        <h1 class="font-serif text-display font-semibold tracking-tight leading-[1.03] rise rise-2">
          {dict.home.heroTitle1}<br />
          {dict.home.heroTitle2}
        </h1>
        <p class="text-lg md:text-xl text-ink-soft mt-7 max-w-xl leading-relaxed rise rise-3">
          {dict.home.heroSubtitle}
        </p>

        <div class="flex flex-wrap items-center gap-3 mt-9 rise rise-4">
          <a href={i18nHref(locale, '/survival/')} class="btn btn-primary">
            {dict.home.startLearning}
          </a>
          <a href={i18nHref(locale, '/library/')} class="btn btn-ghost">
            {dict.home.browseLibrary}
          </a>
          <a href={i18nHref(locale, '/downloads/')} class="btn btn-ghost">
            {dict.home.downloadPrint}
          </a>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-7 mt-14 pt-8 border-t border-line rise rise-5">
          {
            stats.map((s) => (
              <div class="flex flex-col-reverse">
                <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-ink-faint mt-1.5">{s.label}</dt>
                <dd class="font-mono text-2xl md:text-[1.7rem] font-medium text-ink tracking-tight -ml-0.5">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hidden lg:block justify-self-end w-full max-w-md xl:max-w-lg rise rise-3">
        <HeroArt />
      </div>
    </div>
  </section>

  <!-- ── Reconstruction path ── -->
  <section class="py-16 md:py-24">
    <header class="mb-10 max-w-2xl">
      <p class="tech-label text-blue mb-4">{dict.home.reconstructionPath}</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">
        {dict.home.tenStages}
      </h2>
      <p class="text-ink-soft mt-4 text-base md:text-lg leading-relaxed">
        {dict.home.tenStagesDesc}
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        homeStages.map((s, i) => (
          <a href={i18nHref(locale, `/library/?stage=${s.id}`)} class="card group p-6">
            <div class="flex items-baseline justify-between gap-3 mb-5">
              <span class="font-mono text-[13px] font-medium tracking-[0.12em] text-blue">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="tech-label text-ink-faint">
                {dict.home.level} {s.aLevel}
              </span>
            </div>
            <h3 class="font-serif text-xl font-semibold leading-snug tracking-tight">
              {s.name}
            </h3>
            <p class="text-sm text-ink-soft mt-2.5 leading-relaxed">{s.description}</p>
            <span class="inline-flex items-center gap-2 text-[13px] font-medium text-blue mt-5">
              {s.question}
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 arrow-shift" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-9">
      <a href={i18nHref(locale, '/library/')} class="inline-flex items-center gap-2 text-sm font-medium text-blue hover:text-ink transition-colors group">
        {dict.home.viewAllStages}
        <svg viewBox="0 0 24 24" class="w-4 h-4 arrow-shift" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ── Core knowledge ── -->
  <section class="py-16 md:py-24 border-t border-line">
    <header class="flex items-end justify-between mb-10 flex-wrap gap-4">
      <div class="max-w-2xl">
        <p class="tech-label text-blue mb-4">{dict.home.coreKnowledge}</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">{dict.home.deepDives}</h2>
      </div>
      <a href={i18nHref(locale, '/tech/tree/')} class="text-sm font-medium text-blue hover:text-ink transition-colors group inline-flex items-center gap-2">
        {dict.home.interactiveTree}
        <svg viewBox="0 0 24 24" class="w-4 h-4 arrow-shift" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        featured.map((n) => n && (
          <NodeCard locale={locale}
            slug={n.slug}
            title={n.title}
            level={n.entry.data.level}
            category={n.entry.data.category}
            safety={n.entry.data.safety}
            critical={n.entry.data.critical}
            summary={n.summary}
          />
        ))
      }
    </div>
  </section>

  <!-- ── Hubs ── -->
  <section class="py-16 md:py-24 border-t border-line">
    <div class="grid md:grid-cols-3 gap-5">
      <a href={i18nHref(locale, '/emergency/')} class="card group p-7">
        <div class="w-10 h-10 rounded-md bg-warn-soft flex items-center justify-center mb-5">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-warn" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="font-serif text-xl font-semibold tracking-tight mb-2">{dict.home.emergencyHub}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{dict.home.emergencyHubDesc}</p>
        <span class="inline-flex items-center gap-2 text-[13px] font-medium text-blue mt-5">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 arrow-shift" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>

      <a href={i18nHref(locale, '/scenarios/')} class="card group p-7">
        <div class="w-10 h-10 rounded-md bg-blue-soft flex items-center justify-center mb-5">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-blue" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22c-4.97 0-9-2.69-9-6s4.03-6 9-6 9 2.69 9 6-4.03 6-9 6z" stroke-linecap="round"/><path d="M9 10c0-1.66 1.34-3 3-3s3 1.34 3 3" stroke-linecap="round"/></svg>
        </div>
        <h3 class="font-serif text-xl font-semibold tracking-tight mb-2">{dict.home.scenariosHub}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{dict.home.scenariosHubDesc}</p>
        <span class="inline-flex items-center gap-2 text-[13px] font-medium text-blue mt-5">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 arrow-shift" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>

      <a href={i18nHref(locale, '/disasters/')} class="card group p-7">
        <div class="w-10 h-10 rounded-md bg-danger-soft flex items-center justify-center mb-5">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-danger" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01" stroke-linecap="round"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3 class="font-serif text-xl font-semibold tracking-tight mb-2">{dict.home.disastersHub}</h3>
        <p class="text-sm text-ink-soft leading-relaxed">{dict.home.disastersHubDesc}</p>
        <span class="inline-flex items-center gap-2 text-[13px] font-medium text-blue mt-5">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 arrow-shift" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- ── Design principles ── -->
  <section class="py-16 md:py-24 border-t border-line">
    <div class="max-w-3xl">
      <p class="tech-label text-blue mb-4">{dict.home.designPrinciples}</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight mb-10">{dict.home.builtForPermanence}</h2>
      <ol class="border-t border-line">
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-6 border-b border-line">
          <span class="font-mono text-[13px] tracking-[0.12em] text-blue pt-0.5">01</span>
          <div>
            <p class="font-serif text-lg font-semibold tracking-tight">{dict.home.offlineFirst}</p>
            <p class="text-sm text-ink-soft mt-1.5 leading-relaxed">{dict.home.offlineFirstDesc}</p>
          </div>
        </li>
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-6 border-b border-line">
          <span class="font-mono text-[13px] tracking-[0.12em] text-blue pt-0.5">02</span>
          <div>
            <p class="font-serif text-lg font-semibold tracking-tight">{dict.home.printIsPermanent}</p>
            <p class="text-sm text-ink-soft mt-1.5 leading-relaxed">{dict.home.printIsPermanentDesc}</p>
          </div>
        </li>
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-6 border-b border-line">
          <span class="font-mono text-[13px] tracking-[0.12em] text-blue pt-0.5">03</span>
          <div>
            <p class="font-serif text-lg font-semibold tracking-tight">{dict.home.validatedReproducible}</p>
            <p class="text-sm text-ink-soft mt-1.5 leading-relaxed">{dict.home.validatedReproducibleDesc}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>
