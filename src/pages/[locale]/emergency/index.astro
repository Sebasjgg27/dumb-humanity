---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlateArt from '../../../components/PlateArt.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../../i18n/index';
import { getEmergencyData } from '../../../i18n/data';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const { FIRST_AID_TOPICS, SIGNAL_METHODS } = getEmergencyData(locale);

const sections = [
  { id: 'kits', title: dict.emergency.kitsTitle, desc: dict.emergency.kitsDescription, icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'first-aid', title: dict.emergency.firstAidTitle, desc: dict.emergency.firstAidDescription, icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'signals', title: dict.emergency.signalsTitle, desc: dict.emergency.signalsDescription, icon: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke-linecap="round"/>' },
  { id: 'water-purification', title: dict.emergency.waterPurificationTitle, desc: dict.emergency.waterPurificationDescription, icon: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'shelter', title: dict.emergency.shelterTitle, desc: dict.emergency.shelterDescription, icon: '<path d="m3 21 9-9 9 9M5 21V11l7-7 7 7v10" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'food-foraging', title: dict.emergency.foodForagingTitle, desc: dict.emergency.foodForagingDescription, icon: '<path d="M7 20h10M10 20c5.5-2.5 8.8-7 8.8-12.5C18.8 4 15.3 2 12 2c-3.3 0-6.8 2-8.8 5.5 0 0 3 1.5 5.3 3.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 14c1.5 1 3.5 1 5 0" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'evacuation', title: dict.emergency.evacuationTitle, desc: dict.emergency.evacuationDescription, icon: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke-linecap="round" stroke-linejoin="round"/>' },
  { id: 'communication', title: dict.emergency.communicationTitle, desc: dict.emergency.communicationDescription, icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/>' },
];
---

<BaseLayout title={dict.emergency.title} description={dict.emergency.description} locale={locale}>
  <header class="mb-10">
    <div class="flex items-start justify-between gap-8">
      <div class="min-w-0">
        <p class="tech-label text-warn mb-2">{dict.emergency.tagline}</p>
        <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">{dict.emergency.title}</h1>
        <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">{dict.emergency.description}</p>
      </div>
      <PlateArt name="cross" class="hidden md:block w-[260px] lg:w-[320px] shrink-0 -mt-1 no-print" />
    </div>
  </header>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {sections.map((s) => (
      <a href={i18nHref(locale, `/emergency/${s.id}/`)} class="card group p-6">
        <div class="w-12 h-12 rounded-lg bg-warn-soft flex items-center justify-center mb-4">
          <svg viewBox="0 0 24 24" class="w-6 h-6 text-warn" fill="none" stroke="currentColor" stroke-width="1.8">
            <Fragment set:html={s.icon} />
          </svg>
        </div>
        <h2 class="font-semibold text-lg group-hover:text-blue mb-2">{s.title}</h2>
        <p class="text-sm text-ink-soft leading-relaxed">{s.desc}</p>
      </a>
    ))}
  </div>

  <section class="mt-12 pt-8 border-t border-line">
    <div class="flex items-center gap-3 mb-4">
      <span class="shrink-0 w-8 h-8 rounded-full bg-danger-soft text-danger flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <div>
        <p class="font-semibold">{dict.emergency.ruleOfThrees}</p>
        <p class="text-sm text-ink-soft">{dict.emergency.ruleOfThreesDesc}</p>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-4 mt-4">
      <div class="text-center p-3 rounded-lg bg-surface border border-line">
        <p class="font-mono text-lg font-bold text-danger">3</p>
        <p class="text-xs text-ink-faint">{dict.emergency.hoursWithoutShelter}</p>
      </div>
      <div class="text-center p-3 rounded-lg bg-surface border border-line">
        <p class="font-mono text-lg font-bold text-warn">3</p>
        <p class="text-xs text-ink-faint">{dict.emergency.daysWithoutWater}</p>
      </div>
      <div class="text-center p-3 rounded-lg bg-surface border border-line">
        <p class="font-mono text-lg font-bold text-ink-soft">3</p>
        <p class="text-xs text-ink-faint">{dict.emergency.weeksWithoutFood}</p>
      </div>
    </div>
  </section>
</BaseLayout>
