---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../../i18n/index';
import { getEmergencyData } from '../../../i18n/data';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const { EVACUATION_PLANS } = getEmergencyData(locale);
---

<BaseLayout title={dict.emergency.evacuationTitle} description={dict.emergency.evacuationDescription} locale={locale}>
  <nav class="text-xs text-ink-faint no-print mb-4 flex items-center gap-1.5">
    <a href={i18nHref(locale, '/')} class="hover:text-blue">{dict.techArticle.home}</a>
    <span>/</span>
    <a href={i18nHref(locale, '/emergency/')} class="hover:text-blue">{dict.emergency.title}</a>
    <span>/</span>
    <span class="text-ink-soft">{dict.emergency.evacuationTitle}</span>
  </nav>

  <header class="mb-8 border-b border-line pb-6">
    <p class="tech-label text-danger mb-2">{dict.emergency.evacuationTagline}</p>
    <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">{dict.emergency.evacuationTitle}</h1>
    <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">{dict.emergency.evacuationDescription}</p>
  </header>

  <div class="space-y-6">
    {EVACUATION_PLANS.map((plan) => (
      <div class="rounded-lg border border-line bg-surface p-6">
        <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
          <h2 class="font-serif text-xl font-semibold">{plan.name}</h2>
          <span class="shrink-0 text-[11px] font-medium px-2 py-0.5 rounded bg-danger-soft text-danger">{plan.timeEstimate}</span>
        </div>

        <p class="text-sm text-ink-soft mb-5">{plan.scenario}</p>

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-warn mb-3">{dict.emergency.route}</p>
            <ol class="space-y-2">
              {plan.route.map((step, i) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="shrink-0 w-5 h-5 rounded-full bg-warn-soft text-warn flex items-center justify-center text-[11px] font-bold">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-ok mb-3">{dict.emergency.checklist}</p>
            <ul class="space-y-2">
              {plan.checklist.map((item) => (
                <li class="flex items-start gap-2 text-sm">
                  <svg viewBox="0 0 24 24" class="shrink-0 mt-[3px] w-3.5 h-3.5 text-ok" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
