---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../../i18n/index';
import { SHELTER_TYPES } from '../../../data/emergency';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
---

<BaseLayout title={dict.emergency.shelterTitle} description={dict.emergency.shelterDescription} locale={locale}>
  <nav class="text-xs text-ink-faint no-print mb-4 flex items-center gap-1.5">
    <a href={i18nHref(locale, '/')} class="hover:text-blue">{dict.techArticle.home}</a>
    <span>/</span>
    <a href={i18nHref(locale, '/emergency/')} class="hover:text-blue">{dict.emergency.title}</a>
    <span>/</span>
    <span class="text-ink-soft">{dict.emergency.shelterTitle}</span>
  </nav>

  <header class="mb-8 border-b border-line pb-6">
    <p class="tech-label text-danger mb-2">{dict.emergency.shelterTagline}</p>
    <h1 class="font-serif text-3xl md:text-4xl font-bold tracking-tight">{dict.emergency.shelterTitle}</h1>
    <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">{dict.emergency.shelterDescription}</p>
  </header>

  <div class="space-y-6">
    {SHELTER_TYPES.map((shelter) => (
      <div class="rounded-lg border border-line bg-surface p-6">
        <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
          <h2 class="font-serif text-xl font-bold">{shelter.name}</h2>
          <span class="shrink-0 text-[11px] font-medium px-2 py-0.5 rounded bg-blue-soft text-blue">{shelter.environment}</span>
        </div>

        <div class="grid sm:grid-cols-2 gap-3 mb-5">
          <div class="rounded-md bg-bg px-3 py-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-ok mr-2">{dict.emergency.windRating}</span>
            <span>{shelter.windRating}</span>
          </div>
          <div class="rounded-md bg-bg px-3 py-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-warn mr-2">{dict.emergency.warmthRating}</span>
            <span>{shelter.warmthRating}</span>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-blue mb-3">{dict.techArticle.materials}</p>
            <ul class="space-y-2">
              {shelter.materials.map((material) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="shrink-0 mt-[7px] w-1.5 h-1.5 rounded-full bg-blue"></span>
                  <span>{material}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-ok mb-3">{dict.emergency.steps}</p>
            <ol class="space-y-2">
              {shelter.steps.map((step, i) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="shrink-0 w-5 h-5 rounded-full bg-ok-soft text-ok flex items-center justify-center text-[11px] font-bold">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
