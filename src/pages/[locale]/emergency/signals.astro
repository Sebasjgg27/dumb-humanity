---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../../i18n/index';
import { getEmergencyData } from '../../../i18n/data';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const { SIGNAL_METHODS } = getEmergencyData(locale);
---

<BaseLayout title={dict.emergency.signalsTitle} description={dict.emergency.signalsDescription} locale={locale}>
  <nav class="text-xs text-ink-faint no-print mb-4 flex items-center gap-1.5">
    <a href={i18nHref(locale, '/')} class="hover:text-blue">{dict.techArticle.home}</a>
    <span>/</span>
    <a href={i18nHref(locale, '/emergency/')} class="hover:text-blue">{dict.emergency.title}</a>
    <span>/</span>
    <span class="text-ink-soft">{dict.emergency.signalsTitle}</span>
  </nav>

  <header class="mb-8 border-b border-line pb-6">
    <p class="tech-label text-blue mb-2">{dict.emergency.signalsTagline}</p>
    <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">{dict.emergency.signalsTitle}</h1>
    <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">{dict.emergency.signalsDescription}</p>
  </header>

  <section class="mb-8 p-4 rounded-lg bg-warn-soft border border-warn/30">
    <p class="font-semibold text-warn mb-1">{dict.emergency.universalSignal}</p>
    <p class="text-sm text-ink">{dict.emergency.universalSignalDesc}</p>
  </section>

  <div class="space-y-4">
    {SIGNAL_METHODS.map((method) => (
      <div class="rounded-lg border border-line bg-surface p-6">
        <div class="flex items-start justify-between gap-4 mb-2">
          <h2 class="font-serif text-lg font-semibold">{method.name}</h2>
          <span class="shrink-0 text-[11px] font-medium px-2 py-0.5 rounded bg-blue-soft text-blue">{method.visibility}</span>
        </div>
        <p class="text-sm text-ink-soft leading-relaxed mb-3">{method.description}</p>
        <div class="flex items-start gap-2 text-xs">
          <span class="font-semibold text-ink">{dict.emergency.whenToUse}:</span>
          <span class="text-ink-soft">{method.whenToUse}</span>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
