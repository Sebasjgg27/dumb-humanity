---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechTree from '../../../components/TechTree.astro';
import NodeCard from '../../../components/NodeCard.astro';
import { getCollection } from 'astro:content';
import { LEVELS } from '../../../data/levels';
import { getTranslatedLevels } from '../../../i18n/data';
import { getLocalTech } from '../../../i18n/content';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getDictionary, href as i18nHref } from '../../../i18n/index';

export async function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const dict = getDictionary(locale);
const levels = getTranslatedLevels(locale);
const entries = await getCollection('tech');
const tech = await getLocalTech(locale, 130);
---

<BaseLayout title={dict.techTree.title} description={dict.techTree.subtitle} locale={locale}>
  <header class="mb-8">
    <p class="tech-label text-blue mb-2">{dict.techTree.tagline}</p>
    <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight">{dict.techTree.title}</h1>
    <p class="text-ink-soft mt-3 max-w-3xl leading-relaxed">
      {dict.techTree.subtitle}
      <span class="font-medium text-warn">{dict.techTree.criticalPath}</span>{dict.techTree.criticalPathText}
      <span class="font-medium text-danger">{dict.techTree.missingReq}</span>{dict.techTree.missingReqText}
    </p>
  </header>

  <div class="flex items-center gap-3 mb-6 no-print">
    <button data-view="graph" class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-navy text-white">{dict.techTree.graphView}</button>
    <button data-view="list" class="text-sm font-medium px-3 py-1.5 rounded-lg border border-line-strong bg-surface hover:border-blue">{dict.techTree.listView}</button>
  </div>

  <section data-pane="graph">
    <TechTree nodes={entries} locale={locale} />
  </section>

  <section data-pane="list" class="hidden">
    <div class="space-y-8">
      {
        levels.map((l) => {
          const items = tech.filter((t) => t.entry.data.level === l.id).sort((a, b) => a.entry.data.order - b.entry.data.order);
          if (items.length === 0) return null;
          return (
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="tech-label px-2 py-0.5 rounded" style={`background: ${l.color}1a; color: ${l.color}`}>{l.id}</span>
                <h2 class="font-semibold">{l.name}</h2>
                <span class="text-xs text-ink-faint">{items.length} {dict.common.articles}</span>
              </div>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {items.map((n) => (
                  <NodeCard locale={locale}
                    slug={n.slug}
                    title={n.title}
                    level={n.entry.data.level}
                    category={n.entry.data.category}
                    safety={n.entry.data.safety}
                    critical={n.entry.data.critical}
                    summary={n.summary}
                  />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="mt-12 border-t border-line pt-8 print-block">
    <h2 class="font-serif text-xl font-semibold mb-3">{dict.techTree.rules}</h2>
    <ul class="space-y-2 text-ink-soft text-[15px] leading-relaxed">
      <li><strong class="text-ink">{dict.techTree.rule1}</strong>{dict.techTree.rule1Desc}</li>
      <li><strong class="text-ink">{dict.techTree.rule2}</strong>{dict.techTree.rule2Desc}</li>
      <li><strong class="text-ink">{dict.techTree.rule3}</strong>{dict.techTree.rule3Desc}</li>
      <li><strong class="text-ink">{dict.techTree.rule4}</strong>{dict.techTree.rule4Desc}<a href={i18nHref(locale, '/print/')} class="text-blue underline underline-offset-2">{dict.techTree.rule4Link}</a>.</li>
    </ul>
  </section>

  <script>
    (() => {
      const graphBtn = document.querySelector('[data-view="graph"]') as HTMLButtonElement | null;
      const listBtn = document.querySelector('[data-view="list"]') as HTMLButtonElement | null;
      const graph = document.querySelector('[data-pane="graph"]') as HTMLElement | null;
      const list = document.querySelector('[data-pane="list"]') as HTMLElement | null;
      if (!graphBtn || !listBtn) return;
      const setView = (v: 'graph' | 'list') => {
        const g = v === 'graph';
        graph?.classList.toggle('hidden', !g);
        list?.classList.toggle('hidden', g);
        graphBtn.className = g
          ? 'text-sm font-semibold px-3 py-1.5 rounded-lg bg-navy text-white'
          : 'text-sm font-medium px-3 py-1.5 rounded-lg border border-line-strong bg-surface hover:border-blue';
        listBtn.className = g
          ? 'text-sm font-medium px-3 py-1.5 rounded-lg border border-line-strong bg-surface hover:border-blue'
          : 'text-sm font-semibold px-3 py-1.5 rounded-lg bg-navy text-white';
      };
      graphBtn.addEventListener('click', () => setView('graph'));
      listBtn.addEventListener('click', () => setView('list'));
    })();
  </script>
</BaseLayout>
