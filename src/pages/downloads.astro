---
import BaseLayout from '../layouts/BaseLayout.astro';
import pkg from '../../package.json';
import { getCollection } from 'astro:content';

const tech = await getCollection('tech');
const updated = new Date().toISOString().slice(0, 10);

const items = [
  {
    title: 'Offline Library',
    desc: 'The entire archive as static files. Download once, then open on any device with no network, no server, no electricity beyond the screen.',
    action: 'Download ZIP',
    href: 'https://github.com/Sebasjgg27/dumb-humanity/archive/refs/heads/main.zip',
    note: 'Source + content',
  },
  {
    title: 'Complete Manual (Print Pack)',
    desc: 'Every guide formatted for paper. Print the full set and bind it into a physical manual that outlives every screen.',
    action: 'Open print packs',
    href: '/dumb-humanity/print/',
    note: 'Print-ready',
  },
  {
    title: 'Printable Edition',
    desc: 'Per-guide print buttons, clean print CSS, and stage-based packs. Laser toner is more waterproof than inkjet.',
    action: 'Browse editions',
    href: '/dumb-humanity/print/',
    note: 'A4 / Letter',
  },
  {
    title: 'Source Repository',
    desc: 'The markdown source of every article, versioned and freely redistributable. Fork it, translate it, print it.',
    action: 'Open repository',
    href: 'https://github.com/Sebasjgg27/dumb-humanity',
    note: 'Open source',
  },
];
---

<BaseLayout title="Downloads" description="Offline and print versions of the recovery manual.">
  <header class="mb-8">
    <p class="tech-label text-blue mb-2">Digital is temporary. Print is permanent.</p>
    <h1 class="font-serif text-3xl md:text-4xl font-bold tracking-tight">Offline Library</h1>
    <p class="text-ink-soft mt-3 max-w-2xl">
      This archive is designed to be moved, copied, and printed. Power grids fail.
      Screens die. Paper and files you own do not.
    </p>
  </header>

  <div class="grid md:grid-cols-2 gap-4">
    {
      items.map((i) => (
        <div class="rounded-lg border border-line bg-surface p-5 flex flex-col">
          <p class="tech-label text-blue mb-1.5">{i.note}</p>
          <h2 class="font-semibold text-lg">{i.title}</h2>
          <p class="text-sm text-ink-soft mt-1.5 leading-relaxed flex-1">{i.desc}</p>
          <a
            href={i.href}
            class:list={[
              'mt-4 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-colors',
              i.href.startsWith('http')
                ? 'bg-navy text-white hover:bg-navy-light'
                : 'border border-line-strong bg-surface hover:border-blue hover:text-blue',
            ]}
          >
            {i.action}
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
              {i.href.startsWith('http')
                ? '<path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"/>'
                : '<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>'}
            </svg>
          </a>
        </div>
      ))
    }
  </div>

  <section class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-lg border border-line bg-surface p-4">
      <p class="tech-label text-ink-faint mb-1">Version</p>
      <p class="font-mono text-lg font-semibold">v{pkg.version}</p>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <p class="tech-label text-ink-faint mb-1">Last updated</p>
      <p class="font-mono text-lg font-semibold">{updated}</p>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <p class="tech-label text-ink-faint mb-1">Articles</p>
      <p class="font-mono text-lg font-semibold">{tech.length}</p>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <p class="tech-label text-ink-faint mb-1">Total size</p>
      <p class="font-mono text-lg font-semibold">≈ small — fits any USB stick</p>
    </div>
  </section>

  <section class="mt-10 rounded-lg border border-warn/30 bg-warn-soft p-6">
    <p class="tech-label text-warn mb-2">Redundancy doctrine</p>
    <ul class="space-y-2 text-sm text-ink leading-relaxed">
      <li><strong>Three copies, two media, one far away.</strong> Keep a digital copy, a printed copy, and a sealed backup stored separately.</li>
      <li><strong>Print masters, then copy.</strong> Keep one master set dry and sealed; make working copies.</li>
      <li><strong>Copy the ZIP to multiple devices</strong> — a phone, a laptop, a USB drive, an old e-reader. Devices fail; copies survive.</li>
      <li><strong>Teach it.</strong> The most durable format is a person who can explain the knowledge to the next generation.</li>
    </ul>
  </section>
</BaseLayout>
