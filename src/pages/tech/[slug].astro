---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { LEVEL_BY_ID, SAFETY_META, techSlug } from '../../data/levels';
import { difficultyFor, stageFor } from '../../data/stages';

export async function getStaticPaths() {
  const tech = await getCollection('tech');
  return tech.map((t) => ({ params: { slug: techSlug(t.id) }, props: { tech: t } }));
}

const { tech } = Astro.props;
const { Content } = await render(tech);
const lvl = LEVEL_BY_ID[tech.data.level as keyof typeof LEVEL_BY_ID];
const safety = SAFETY_META[tech.data.safety];
const stage = stageFor(tech.id);
const diff = difficultyFor(tech.id, tech.data.level);

const allTech = await getCollection('tech');
const bySlug = new Map(allTech.map((t) => [techSlug(t.id), t]));
const refId = (r: unknown) => (r as { id?: string; slug?: string }).id ?? (r as string);
const prereqs = tech.data.prerequisites.map((r) => bySlug.get(refId(r))).filter(Boolean);
const unlocks = tech.data.unlocks.map((r) => bySlug.get(refId(r))).filter(Boolean);

const body = tech.body;
const hasScience = /the chemistry|the concept|the principle|the science|how .* works|why .*\?|^#+ .*(physic|chemis|mechanic|principle)/i.test(body);
const hasIllustrations = /\|/m.test(body) || /- \[ \]/.test(body) || /^#{1,6} .*(diagram|illustrat)/mi.test(body);
const prereqsComplete = prereqs.length === tech.data.prerequisites.length;
const pathValid = prereqsComplete && unlocks.length + tech.data.prerequisites.length > 0;
const related = allTech
  .filter((t) => t.id !== tech.id && (t.data.category === tech.data.category || t.data.level === tech.data.level))
  .slice(0, 6);

const validation = [
  { label: 'Prerequisites Complete', ok: prereqsComplete },
  { label: 'Scientific Accuracy Verified', ok: hasScience },
  { label: 'Illustrations Included', ok: hasIllustrations },
  { label: 'Print Ready', ok: true },
  { label: 'Offline Ready', ok: true },
  { label: 'Reconstruction Path Valid', ok: pathValid },
];
const validated = validation.every((v) => v.ok);
---

<BaseLayout title={tech.data.title} description={`${tech.data.title} — ${tech.data.category}, Level ${tech.data.level}`}>
  <nav class="text-xs text-ink-faint no-print mb-4 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
    <a href="/dumb-humanity/" class="hover:text-blue">Home</a>
    <span>/</span>
    <a href="/dumb-humanity/library/" class="hover:text-blue">Library</a>
    <span>/</span>
    <a href={`/dumb-humanity/library/?stage=${stage.id}`} class="hover:text-blue">{stage.name}</a>
    <span>/</span>
    <span class="text-ink-soft">{tech.data.title}</span>
  </nav>

  <header class="mb-8 border-b border-line pb-6">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="tech-label px-2 py-1 rounded bg-navy text-white">Level {tech.data.level}</span>
      <span class="text-xs font-medium px-2 py-1 rounded bg-blue-soft text-blue">{tech.data.category}</span>
      <span class="text-xs font-medium px-2 py-1 rounded" style={`background: ${safety.color}1a; color: ${safety.color}`}>Risk: {safety.label}</span>
      {tech.data.critical && <span class="text-xs font-semibold px-2 py-1 rounded bg-warn-soft text-warn">Core technology</span>}
    </div>
    <h1 class="font-serif text-3xl md:text-4xl font-bold tracking-tight">{tech.data.title}</h1>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
      <div>
        <p class="tech-label text-ink-faint mb-1.5">Difficulty</p>
        <div class="flex items-center gap-1.5">
          <div class="flex gap-1" title={`Difficulty ${diff} of 5`}>
            {[1, 2, 3, 4, 5].map((i) => (
              <span
                class:list={['w-3.5 h-3.5 rounded-sm border', i <= diff ? 'bg-navy border-navy' : 'bg-surface border-line-strong']}
              ></span>
            ))}
          </div>
          <span class="text-sm font-mono text-ink-soft">{diff}/5</span>
        </div>
      </div>
      <div>
        <p class="tech-label text-ink-faint mb-1.5">Civilization level required</p>
        <p class="text-sm font-medium"><span class="font-mono font-semibold" style={`color: ${lvl.color}`}>{tech.data.level}</span> — {lvl.name}</p>
      </div>
      <div>
        <p class="tech-label text-ink-faint mb-1.5">Estimated study time</p>
        <p class="text-sm font-medium">{tech.data.time_estimate}</p>
      </div>
      <div>
        <p class="tech-label text-ink-faint mb-1.5">Stage</p>
        <p class="text-sm font-medium">{String(stage.index + 1).padStart(2, '0')} · {stage.name}</p>
      </div>
    </div>

    <div class="mt-5">
      <p class="tech-label text-ink-faint mb-1.5">Required knowledge</p>
      {
        prereqs.length > 0 ? (
          <div class="flex flex-wrap gap-2">
            {prereqs.map((p) => (
              <a
                href={`/dumb-humanity/tech/${p!.id}/`}
                class="inline-flex items-center gap-1.5 text-[13px] font-medium px-2.5 py-1 rounded-md bg-blue-soft text-blue hover:bg-blue hover:text-white transition-colors"
              >
                {p!.data.title}
                <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-ink-soft">None — this is a foundational technology.</p>
        )
      }
    </div>
  </header>

  <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-8">
    <article class="prose-tech min-w-0">
      <Content />
    </article>

    <aside class="space-y-4 min-w-0">
      <div class="rounded-lg border border-line bg-surface p-4">
        <p class="tech-label text-ink-faint mb-3">Knowledge validation</p>
        <ul class="space-y-2">
          {
            validation.map((v) => (
              <li class="flex items-center gap-2 text-[13px]">
                <span
                  class:list={[
                    'shrink-0 w-4.5 h-4.5 rounded-full flex items-center justify-center',
                    v.ok ? 'bg-ok-soft text-ok' : 'bg-line text-ink-faint',
                  ]}
                >
                  {v.ok ? (
                    <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg>
                  )}
                </span>
                <span class:list={[v.ok ? 'text-ink' : 'text-ink-soft']}>{v.label}</span>
              </li>
            ))
          }
        </ul>
        {
          validated && (
            <p class="mt-3 text-xs font-medium text-ok bg-ok-soft rounded px-2 py-1.5">
              All validation checks pass.
            </p>
          )
        }
      </div>

      <div class="rounded-lg border border-line bg-surface p-4">
        <p class="tech-label text-ink-faint mb-3">Specifications</p>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between gap-2"><dt class="text-ink-soft">Materials</dt><dd class="font-medium text-right">{tech.data.materials.join(', ') || '—'}</dd></div>
          <div class="flex justify-between gap-2"><dt class="text-ink-soft">Energy</dt><dd class="font-medium">{tech.data.energy}</dd></div>
          <div class="flex justify-between gap-2"><dt class="text-ink-soft">People</dt><dd class="font-medium">{tech.data.people}</dd></div>
          {tech.data.dr_stone_ref && (
            <div class="flex justify-between gap-2"><dt class="text-ink-soft">Reference</dt><dd class="font-medium text-right italic">{tech.data.dr_stone_ref}</dd></div>
          )}
        </dl>
      </div>

      {tech.data.salvage.length > 0 && (
        <div class="rounded-lg border border-warn/30 bg-warn-soft p-4">
          <p class="tech-label text-warn mb-2">Scavenge before building</p>
          <ul class="list-disc pl-4 space-y-1 text-[13px] text-ink leading-relaxed">
            {tech.data.salvage.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      )}

      {unlocks.length > 0 && (
        <div class="rounded-lg border border-line bg-surface p-4">
          <p class="tech-label text-ink-faint mb-3">Unlocks next</p>
          <ul class="space-y-1.5">
            {unlocks.map((u) => (
              <li>
                <a href={`/dumb-humanity/tech/${u!.id}/`} class="text-[13px] text-ink-soft hover:text-blue flex items-center justify-between gap-2">
                  <span>{u!.data.title}</span>
                  <span class="text-ink-faint shrink-0 font-mono text-[11px]">{u!.data.level}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-lg border border-line bg-surface p-4">
        <p class="tech-label text-ink-faint mb-3">Dependencies</p>
        <div class="space-y-2">
          {prereqs.map((p) => (
            <a href={`/dumb-humanity/tech/${p!.id}/`} class="flex items-center gap-2 text-[13px] text-ink hover:text-blue">
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0 text-ink-faint" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14" stroke-linecap="round"/><path d="M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {p!.data.title}
            </a>
          ))}
          {prereqs.length === 0 && <p class="text-[13px] text-ink-soft">No dependencies.</p>}
        </div>
      </div>

      <div class="space-y-2">
        <button
          data-master-toggle
          class="w-full text-sm font-semibold px-3 py-2.5 rounded-lg bg-navy text-white hover:bg-navy-light transition-colors no-print"
        >
          Mark as mastered
        </button>
        <button onclick="window.print()" class="w-full text-sm font-medium px-3 py-2.5 rounded-lg border border-line-strong bg-surface hover:border-blue hover:text-blue transition-colors no-print">
          Print this guide
        </button>
        <a href="/dumb-humanity/downloads/" class="block text-center w-full text-sm font-medium px-3 py-2.5 rounded-lg border border-line-strong bg-surface hover:border-blue hover:text-blue transition-colors no-print">
          Export options
        </a>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="mt-12 pt-8 border-t border-line">
      <p class="tech-label text-ink-faint mb-4">Related articles</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {
          related.map((r) => (
            <a href={`/dumb-humanity/tech/${techSlug(r.id)}/`} class="rounded-lg border border-line bg-surface p-4 hover:border-blue/50 transition-colors">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[11px] font-mono text-ink-faint">{r.data.level}</span>
                <span class="text-[11px] text-ink-faint">{r.data.category}</span>
              </div>
              <p class="text-sm font-semibold">{r.data.title}</p>
            </a>
          ))
        }
      </div>
    </section>
  )}

  <script>
    (() => {
      const KEY = 'crp-mastered';
      const slug = window.location.pathname.split('/').filter(Boolean).pop() ?? '';
      const btn = document.querySelector('[data-master-toggle]') as HTMLButtonElement | null;
      if (!btn) return;
      let done: string[] = [];
      try { done = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { done = []; }
      const set = new Set(done);
      const render = () => {
        btn.textContent = set.has(slug) ? '✓ Mastered — click to undo' : 'Mark as mastered';
        btn.classList.toggle('opacity-60', set.has(slug));
      };
      btn.addEventListener('click', () => {
        if (set.has(slug)) set.delete(slug);
        else set.add(slug);
        localStorage.setItem(KEY, JSON.stringify([...set]));
        render();
      });
      render();
    })();
  </script>
</BaseLayout>
