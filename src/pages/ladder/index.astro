---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LEVELS } from '../../data/levels';
---

<BaseLayout title="The Ladder" description="The six-stage rebuild ladder: from survival to frontier.">
  <header class="mb-10">
    <p class="tech-label text-blue mb-2">The framework</p>
    <h1 class="font-serif text-3xl md:text-4xl font-bold">The Rebuild Ladder</h1>
    <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">
      Inspired by the <em>InfoPreserver</em> project's capability ladder and
      <em>Dr. Stone's</em> staged tech progression. Each level answers one question.
      You cannot skip rungs — but every rung mastered makes the next one faster.
    </p>
  </header>

  <div class="space-y-5">
    {
      LEVELS.map((l, i) => (
        <a
          href={`/dumb-humanity/ladder/${l.id}/`}
          class="block rounded-lg border border-line bg-surface p-6 hover:border-blue/40 hover:shadow-sm transition-all print-break"
        >
          <div class="flex items-center gap-4">
            <div class="shrink-0 flex flex-col items-center">
              <span class="w-12 h-12 rounded-lg flex items-center justify-center font-serif font-bold text-white text-lg" style={`background: ${l.color}`}>
                {l.id}
              </span>
            </div>
            <div class="min-w-0">
              <p class="text-xs text-ink-soft font-medium">{l.timeframe}</p>
              <h2 class="font-serif text-xl font-bold">{l.name}</h2>
              <p class="text-warn font-semibold text-sm mt-0.5">{l.question}</p>
            </div>
            <div class="flex-1" />
            <span class="hidden sm:block text-sm text-ink-soft">{i + 1} of {LEVELS.length}</span>
          </div>
          <p class="text-ink-soft text-[15px] leading-relaxed mt-4 max-w-3xl">{l.description}</p>
          <p class="text-xs text-ink-faint mt-3 italic">Dr. Stone parallel: {l.dr_stone}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
