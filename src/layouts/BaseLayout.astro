---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { LOCALE_MAP, type Locale } from '../i18n/locales';
import { getDictionary } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
  locale?: Locale;
}

const { title, description, sidebar = true, locale = 'en' } = Astro.props;
const dict = getDictionary(locale);
const localeConfig = LOCALE_MAP[locale];
const siteTitle = dict.site.title;
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const metaDesc = description ?? dict.site.description;
---

<!doctype html>
<html lang={locale} dir={localeConfig.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131211" />
    <link rel="icon" href="/dumb-humanity/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/dumb-humanity/icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content="https://sebasjgg27.github.io/dumb-humanity/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content="https://sebasjgg27.github.io/dumb-humanity/og.png" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} dict={dict} />

    {
      sidebar && (
        <div class="sidebar-backdrop no-print" aria-hidden="true"></div>
      )
    }

    <div class="flex-1 flex">
      {
        sidebar && (
          <aside
            class="sidebar-container shrink-0 bg-surface border-r border-line no-print"
            aria-label={dict.aria.knowledgeTree}
          >
            <div class="px-4 py-6 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
              <Sidebar locale={locale} dict={dict} />
            </div>
          </aside>
        )
      }

      <main class="flex-1 min-w-0 px-5 sm:px-8 lg:px-12 xl:px-16 py-9 lg:py-14 max-w-7xl mx-auto w-full">
        <slot />
      </main>
    </div>

    <Footer locale={locale} dict={dict} />
  </body>
</html>

<style>
  @media (max-width: 1023px) {
    .sidebar-container {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      z-index: 60;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: none;
    }
    body.sidebar-open .sidebar-container {
      transform: translateX(0);
      box-shadow: 8px 0 30px rgba(0, 0, 0, 0.3);
    }
    .sidebar-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(12, 10, 9, 0.45);
      z-index: 55;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body.sidebar-open .sidebar-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
  }
  @media (min-width: 1024px) {
    .sidebar-container {
      width: 272px;
    }
  }
</style>
