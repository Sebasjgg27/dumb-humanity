---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LadderNav from '../components/LadderNav.astro';

interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
}

const { title, description, sidebar = true } = Astro.props;
const siteTitle = 'Rebirth Manual';
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? 'The practical manual for restarting human civilization, from fire to industry.'} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/dumb-humanity/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <div class="flex-1 flex">
      {
        sidebar && (
          <aside class="no-print hidden lg:block w-60 shrink-0 border-r border-rule py-6 px-4 sticky top-14 self-start max-h-[calc(100vh-3.5rem)] overflow-y-auto">
            <LadderNav />
          </aside>
        )
      }
      <main class="flex-1 min-w-0 px-4 sm:px-8 py-8 max-w-5xl mx-auto w-full">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
